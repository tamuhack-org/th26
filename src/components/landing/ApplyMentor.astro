---
import applyButton from '@assets/apply-button.png';
import mentorButton from '@assets/mentor-button.png';
import Sticker from './Sticker.astro';
---

<div class="flex gap-3">
	<a
		class="cursor-pointer"
		href="https://start.tamuhack.com"
		target="_blank"
		rel="noopener"
	>
		<Sticker
			imageSrc={applyButton}
			label="Apply button"
			peelDirection={-25}
			backColor="#DEC299"
			class="w-25 sm:w-30"
		/>
	</a>
	<a
		class="mt-12 cursor-pointer sm:mt-15"
		href="https://tamuhack.org/mentor"
		target="_blank"
		rel="noopener"
	>
		<Sticker
			imageSrc={mentorButton}
			label="Mentor button"
			peelDirection={-25}
			backColor="#DEC299"
			class="w-25 sm:w-30"
		/>
	</a>
</div>
