---
import { Picture } from 'astro:assets';
import applyButton from '@assets/apply-button.png';
import mentorButton from '@assets/mentor-button.png';
---

<div class="flex gap-5">
	<a
		class="cursor-pointer"
		href="https://start.tamuhack.com"
		target="_blank"
		rel="noopener"
	>
		<Picture
			src={applyButton}
			alt="Apply button"
			formats={['avif', 'webp', 'png']}
			class="w-40"
		/>
	</a>
	<a
		class="cursor-pointer mt-18"
		href="https://tamuhack.org/mentor"
		target="_blank"
		rel="noopener"
	>
		<Picture
			src={mentorButton}
			alt="Mentor button"
			formats={['avif', 'webp', 'png']}
			class="w-40"
		/>
	</a>
</div>
