---
import { Image } from 'astro:assets';

import banana from '@assets/landing/banana.svg';
import blueberry from '@assets/landing/blueberry.svg';
import strawberry from '@assets/landing/strawberry.svg';

import strawberrysimple from '@assets/genInfo/strawberry.svg';
import blueberrysimple from '@assets/genInfo/blueberry.svg';
import questionSeals from '@assets/genInfo/question-seals.svg';

import middleSectionOranges from '@assets/genInfo/middle-section-oranges.png';
import middleSectionTiger from '@assets/genInfo/middle-section-tiger.png';
import bananaSticker from '@assets/genInfo/sticker-banana.png';
import starSticker from '@assets/genInfo/sticker-star.png';
import heart from '@assets/genInfo/sticker-heart.png';
import laptopTiger from '@assets/genInfo/laptop-tigers.png';
---

<section id="about" class="hero">
    <div class="top-section">
        <span>TAMUhack is a</span>
        <div class="title-row">
            <img src={banana.src} class="icon" alt="Banana" />
            <img src={strawberry.src} class="icon" alt="Strawberry" />
            <img src={blueberry.src} class="icon" alt="Blueberry" />
            <span class="event-title">24-hour event</span>
        </div>

        <span>
            where teams create innovative <span class="text-blue"
                >software &</span
            >
            <br />
            <span class="text-blue">hardware</span> solutions to
        </span>

        <span class="tag tag-brown"> real-world problems </span>

        <span>
            in a community <img
                src={heart.src}
                class="icon-heart heart-mobile"
            /> of mentorship. <img
                src={heart.src}
                class="icon-heart heart-desktop"
            />
        </span>
    </div>

    <div class="middle-section">
        <div class="middle-section-tags">
            <div class="tag-wrapper-orange">
                <div class="tag tag-orange">
                    <p>800+ attendees</p>
                </div>
                <svg
                    width="34"
                    height="25"
                    viewBox="0 0 34 25"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="sticker squiggle"
                    id="squiggle"
                >
                    <path
                        d="M1.34033 9.15907C4.14758 0.135754 17.3818 -1.46839 20.5901 6.75285C23.7984 14.9741 16.828 20.4078 13.1709 16.9792C9.96261 13.9714 19.5875 6.75269 27.0066 8.75795C34.4258 10.7632 35.2279 22.5937 24.6004 23.3958"
                        stroke="#EF9C26"
                        stroke-width="2.80725"></path>
                </svg>
                <img src={starSticker.src} class="sticker sticker-star" />
            </div>

            <div class="tag-wrapper-yellow">
                <div class="tag tag-yellow">
                    <p>$15,000+ in prizes</p>
                </div>
                <img src={bananaSticker.src} class="sticker sticker-banana" />
            </div>
        </div>

        <div class="middle-section-assets">
            <img src={laptopTiger.src} />
        </div>
    </div>

    <div class="bottom-section">
        <Image
            src={questionSeals}
            alt="Blueberry seals questioning life right now"
            class={'hidden lg:block'}
        />
        <div>
            <div class="location-tilt">
                <img
                    src={strawberrysimple.src}
                    class="icon-simple"
                    alt="Strawberry simple"
                />
                <p class="info-text text-red">
                    <span class="semibold-text">Bethancourt Ballroom</span><br
                    /> 730 Olsen Blvd <br /> College Station, TX 77485
                </p>
            </div>

            <div class="hardware-tilt">
                <img
                    src={blueberrysimple.src}
                    class="icon-simple"
                    alt="Blueberry simple"
                />
                <div>
                    <p class="info-text text-blue">
                        <span class="bold-text">Interested in hardware?</span
                        ><br />Hardware will begin Jan. 15 and<br />teams will
                        have a week to create<br />their projects.
                    </p>
                    <p class="text-blue text-base sm:text-lg">
                        More details coming soon!
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        min-height: 100vh;
        padding-left: 2rem;
        padding-right: 2rem;
        padding-bottom: 2rem;
        font-size: 1.5rem;
    }

    .top-section {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        max-width: none;
        width: 100%;
        height: 100%;
        position: relative;
        z-index: 2;
        color: #774a4e;
    }

    .middle-section {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 0.75rem;
        max-width: none;
        aspect-ratio: 2 / 1;
        width: 100%;
        height: 100%;
        position: relative;
        z-index: 2;
        margin-top: 5%;
        justify-content: center;
    }

    .middle-section-tags {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        max-width: none;
        width: 100%;
        height: 100%;
        position: relative;
        z-index: 2;
    }

    .middle-section-assets {
        display: none;
        flex-direction: column;
        align-items: flex-start;
        max-width: 500px;
        width: 100%;
        height: 100%;
        margin-top: -5%;
        position: relative;
        z-index: 2;
    }

    .headline {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .intro {
        font-size: 2.5rem;
        font-weight: 500;
        color: #4a4a4a;
        margin: 0;
    }

    .title-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .icons {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .icon {
        height: 1em;
        width: auto;
        display: inline-block;
    }

    .icon-heart {
        height: 2em;
        display: inline-block;
        width: auto;
    }

    .event-title {
        font-weight: 500;
        color: #e63b2e; /* Red-orange */
        margin: 0;
        font-size: 1.875rem;
    }

    .text-blue {
        color: #3457c3;
    }

    .tag {
        display: inline-block;
        padding: 0.5rem 1.25rem;
        border-radius: 0.5rem;
        font-weight: 500;
    }

    .tag-brown {
        background-color: #774a4e;
        color: #fff6e5;
        transform: rotate(-3deg);
        box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
        margin-block: 1rem;
    }

    .tag-yellow {
        background-color: #ef9c26;
        color: #774a4e;
        transform: rotate(3deg);
        box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
        margin-top: 2rem;
        white-space: nowrap;
    }

    .tag-orange {
        background-color: #e3442f;
        color: #fff6e5;
        transform: rotate(-3deg);
        box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
        margin-top: 1.75rem;
        white-space: nowrap;
        align-self: flex-start;
    }

    .tag-wrapper {
        position: relative;
        width: fit-content;
    }

    .tag-wrapper-orange {
        align-self: flex-start;
        position: relative;
        width: fit-content;
    }

    .tag-wrapper-yellow {
        align-self: flex-end;
        position: relative;
        width: fit-content;
    }

    .sticker {
        position: absolute;
    }

    .sticker-banana {
        width: 23%;
        top: 0%;
        right: -10%;
    }

    .squiggle {
        transform: scale(1.4);
        top: 20%;
        right: -5%;
    }

    .sticker-star {
        width: 20%;
        top: 45%;
        left: -8%;
        transform: translateY(-50%);
    }

    .bottom-section {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2rem;
        position: relative;
        margin-top: 2rem;
    }

    .info-text {
        font-size: 1.25rem;
        margin-top: 1rem;
    }

    .bold-text {
        font-weight: 700;
    }

    .semibold-text {
        font-weight: 600;
    }

    .text-red {
        color: #e3442f;
    }

    .text-blue {
        color: #3457c3;
    }

    .hardware-tilt {
        /* transform: rotate(-1deg); */
    }

    .location-tilt {
        /* transform: rotate(1.5deg); */
    }

    .icon-simple {
        height: 3em;
        width: auto;
    }

    .heart-desktop {
        display: none;
    }

    .heart-mobile {
        display: inline;
    }

    @media (min-width: 630px) {
        .middle-section-assets {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            max-width: 500px;
            width: 100%;
            height: 100%;
            margin-top: -5%;
            position: relative;
            z-index: 2;
        }

        .tag-wrapper-orange {
            position: relative;
            width: fit-content;
            align-self: unset;
        }

        .tag-wrapper-yellow {
            position: relative;
            width: fit-content;
            align-self: unset;
        }

        .middle-section {
            display: flex;
            flex-direction: row;
            align-items: flex-end;
            gap: 0.75rem;
            max-width: none;
            width: 100%;
            position: relative;
            z-index: 2;
        }

        .middle-section-tags {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: flex-start;
            gap: 0.75rem;
            width: 100%;
            position: relative;
            z-index: 2;
        }

        .heart-desktop {
            display: inline;
        }

        .heart-mobile {
            display: none;
        }
        
        .info-text {
            font-size: 2rem;
        }

        .bottom-section {
            display: flex;
            flex-direction: row;
            justify-content: space-around;
            gap: 2rem;
            position: relative;
        }

        .location-tilt {
            align-items: center;
            display: flex;
            flex-direction: row;
            gap: 1rem;
            transform: rotate(1.5deg);
        }

        .hardware-tilt {
            align-items: center;
            display: flex;
            flex-direction: row-reverse;
            gap: 1rem;
            transform: rotate(-1deg);
        }
    }

    @media (max-width: 630px) {
        .middle-section-assets {
            display: none;
        }

        .middle-section {
            margin-top: 5%;
            justify-content: center;
        }

        .middle-section-tags {
            flex-direction: column-reverse;
            align-items: center;
        }
        
        .bottom-section > div {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 2rem;
            position: relative;
        }
    }
</style>

<script>
    import gsap from 'gsap';
    import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(DrawSVGPlugin, ScrollTrigger);
    console.clear();

    const defaults = {
        ease: 'power2.out',
        duration: 1,
    };

    gsap.set('#squiggle path', { drawSVG: '0%' });

    gsap.to('#squiggle path', {
        drawSVG: '100%',
        duration: 1,
        ease: 'power2.out',
        scrollTrigger: {
            trigger: '#squiggle',
            start: 'top 65%',
        },
    });
</script>
