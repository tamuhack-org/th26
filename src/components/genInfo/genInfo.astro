
---
import banana from '@assets/landing/banana.svg';
import blueberry from '@assets/landing/blueberry.svg';
import strawberry from '@assets/landing/strawberry.svg';

import strawberrysimple from '@assets/genInfo/strawberry.svg';
import blueberrysimple from '@assets/genInfo/blueberry.svg';
---

<section id="about" class="hero">
  <div class="top-section">
        <span>TAMUhack is a</span>
        <div class="title-row">
            <img src={banana.src} class="icon" alt="Banana" />
            <img src={strawberry.src} class="icon" alt="Strawberry"/>
            <img src={blueberry.src} class="icon" alt="Blueberry"/>
            <span class="event-title">24-hour event</span>
        </div>

        <span>
        where teams create innovative <span class="text-blue">software &</span>
        <br />
        <span class="text-blue">hardware</span> solutions to
        </span>

        <span class="tag tag-brown">
            real-world problems
        </span>

        <span>
        in a community of mentorship.
        </span>
    </div>

    <div class="middle-section">
        <div class="tag tag-yellow">
            <p>$15,000+ in prizes</p>
        </div>
        <div class="tag tag-orange">
            <p>800+ attendees</p>
        </div>
    </div>
    
    <div class="bottom-section">
      <div class="location-tilt">
        <img src={strawberrysimple.src} class="icon-simple" alt="Strawberry simple" />
        <p class="info-text text-red"><span class="semibold-text">Bethancourt Ballroom</span><br /> 730 Olsen Blvd <br />  College Station, TX 77485</p> 
      </div>

      <div class="hardware-tilt">
        <img src={blueberrysimple.src} class="icon-simple" alt="Blueberry simple" />
        <p class="info-text text-blue"><span class="bold-text">Interested in hardware?</span><br />Hardware will begin Jan. 15 and<br />teams will have a week to create<br />their projects.
        </p>
        <p class="text-blue">More details coming soon!</p>
      </div>
    </div>
</section>

<style>
.hero{
    position: relative;
    min-height: 100vh;
    padding-left: 2rem;
    padding-right: 2rem;
    padding-bottom: 2rem;
}

  .top-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: none;
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 2;
    font-size: 1.5rem;
    color: #774A4E;
  }

  .middle-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: none;
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icons {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .icon {
    height: 1em;
    width: auto;
    display: inline-block;
  }

  .event-title {
    font-weight: 500;
    color: #e63b2e; /* Red-orange */
    margin: 0;
    font-size: 1.875rem;
  }

  .text-blue {
    color: #3457C3;
  }

  .tag {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 1.5rem;
    font-weight: 500;
  }

  .tag-brown {
    background-color: #774A4E;
    color: #FFF6E5;
    transform: rotate(-3deg);
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    margin-block: 1rem;
  }

  .tag-yellow {
    background-color: #EF9C26;
    color: #774A4E;
    transform: rotate(3deg);
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    margin-top: 2.0rem;
  }

  .tag-orange {
    background-color: #E3442F;
    color: #FFF6E5;
    transform: rotate(-3deg);
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    margin-top: 1.75rem;
  }

.bottom-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start; 
  gap: 2rem;
  position: relative;
  margin-top: 2rem;
}

.info-text {
  font-size: 1.25rem;
  margin-top: 1rem;
}

.bold-text {
  font-weight: 700;
}

.semibold-text {
  font-weight: 600;
}

.text-red {
  color: #E3442F;
}

.text-blue {
  color: #3457C3;
}

.hardware-tilt {
    /* transform: rotate(-1deg); */
}

.location-tilt {
    /* transform: rotate(1.5deg); */
}

.icon-simple {
  height: 3em;
  width: auto;
}

</style>
