---
interface Item {
    name: string;
    link: string;
}

interface Props {
    title: string;
    items: Item[];
}

const { title, items } = Astro.props;
---

<div role="region" aria-label={title}>
    <h2 class="mb-2 text-base font-light">{title}</h2>
    
    <nav aria-label={`${title} navigation`}>
        <ul class="list-none p-0">
            {items.map((item) => (
                <li class="mb-2">
                    <a
                        href={item.link}
                        target="_blank"
                        rel="noreferrer noopener"
                        class="rounded text-lg font-medium transition-colors hover:underline focus:outline-none focus:ring-2 focus:ring-blue-500"
                        aria-label={`${item.name} (opens in new tab)`}
                    >
                        {item.name}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</div>
