---
import jaggededge from '@assets/prizes/jagged-edge.png';
import PrizesBarcode from '@assets/prizes/prizes-barcode.svg';
import { Category, type Prize, type PrizeTuple } from './prizes.ts';

interface Props {
    prize: Prize;
}

const { prize } = Astro.props;

const jaggedBgUrl = `url(${jaggededge.src})`;

let barColor = 'bg-[#E3442F]'; // red bar for software -- default

if (prize.placement === 'first') {
    const animatedGradient =
        'motion-safe:bg-linear-[90deg,#FF9AA4,#FAD0C4_12%,#FBC2EB_28%,#A18CD1_43%,#8FD3F4_59%,#84FAB0_75%,#FECEC2_89%,#FF9AA4] animate-gradient motion-safe:bg-[length:200%_auto]'; // animated gradient bar for first place
    let staticGradient = '';
    if (prize.type === Category.HARDWARE) {
        staticGradient =
            'motion-reduce:bg-linear-[90deg,#84FAB0_6%,#8FD3F4_26%,#A18CD1_43%,#FBC2EB_61%,#FFE7FD_83%,#FF9ABC]'; // static gradient bar for first place hardware prize
    } else {
        staticGradient =
            'motion-reduce:bg-linear-[90deg,#FF9A9E,#FAD0C4_25%,#FBC2EB_39%,#A18CD1_57%,#8FD3F4_79%,#84FAB0_94%]'; // static gradient bar for first place software prizes
    }
    barColor = animatedGradient + ' ' + staticGradient; // gradient bar for first place
} else if (prize.type === Category.HARDWARE) {
    barColor = 'bg-[#3457C3]'; // blue bar for hardware prizes
}
---

<div
    class="text-brown prize-shadow jagged-edge relative flex max-w-sm flex-col gap-1 rounded-b-2xl bg-white px-4.5 pt-6 pb-4"
>
    <div class:list={['h-1.5', barColor]} aria-hidden="true"></div>

    <h2 class="sr-only">
        {(prize.placement ? prize.placement + ' place ' : '') + prize.track}
    </h2>

    <div class="flex justify-between">
        <div
            class="font-family-bbh text-xl capitalize min-[28rem]:text-2xl"
            aria-hidden="true"
        >
            <h2 class="first-letter:uppercase" aria-hidden="true">
                {prize.placement ? prize.placement + ' place' : ''}
            </h2>
            <h2 aria-hidden="true">{prize.track}</h2>
        </div>
        <div class="mt-2 flex-none" aria-hidden="true">
            <PrizesBarcode class="w-18.5 text-amber-900" />
        </div>
    </div>
    <p class="text-center text-sm">{prize.description}</p>
    <p
        class="pointer-events-none overflow-hidden text-sm whitespace-nowrap"
        aria-hidden="true"
    >
        - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        -
    </p>
    <dl aria-label="List of prizes">
        {
            prize.prizes.map((prize) => (
                <div class="flex justify-between uppercase">
                    <dt>{prize[0]}</dt>
                    <dd>
                        <span class="sr-only">
                            {typeof prize[1] === 'number'
                                ? 'Price'
                                : 'Placement'}
                            :
                        </span>
                        {typeof prize[1] === 'number'
                            ? prize[1].toFixed(2)
                            : prize[1]}
                    </dd>
                </div>
            ))
        }
    </dl>
</div>

<style define:vars={{ jaggedBgUrl }}>
    .prize-shadow {
        box-shadow: 2.98px 5.1px 3.4px 0px rgba(52, 49, 49, 0.3);
    }

    .jagged-edge::before {
        content: '';
        display: block;
        width: 100%;
        height: 29px;

        position: absolute;
        top: -29px;
        left: 0;

        background-image: var(--jaggedBgUrl);
    }

    @keyframes gradient-scroll {
        0% {
            background-position: 0% 50%;
        }
        100% {
            background-position: 200% 50%;
        }
    }

    .animate-gradient {
        animation: gradient-scroll 10s linear infinite;
        @media (prefers-reduced-motion: reduce) {
            animation: none;
        }
    }
</style>
