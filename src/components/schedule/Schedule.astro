---
import ScheduleTransition from "@components/ScheduleTransition.astro";
import shoppingCart from "@assets/schedule/cart.svg";
import lemonSchedule from "@assets/schedule/lemon-schedule.png";
import Image from "astro/components/Image.astro";
import ScheduleDay from "./ScheduleDay.astro";

export const prerender = false


const response = await fetch('https://team.tamuhack.org/api/hh25');
const data = await response.json();

// Filter events by day based on the date field
const saturdayEvents = data
    .filter((item) => {
        const date = new Date(item.date);
        const dayInCST = new Date(
            date.toLocaleString('en-US', { timeZone: 'America/Chicago' }),
        ).getDay();
        return dayInCST === 6; // 6 = Saturday
    })
    .sort((a, b) => new Date(a.date) - new Date(b.date));

const sundayEvents = data
    .filter((item) => {
        const date = new Date(item.date);
        const dayInCST = new Date(
            date.toLocaleString('en-US', { timeZone: 'America/Chicago' }),
        ).getDay();
        return dayInCST === 0; // 0 = Sunday
    })
    .sort((a, b) => new Date(a.date) - new Date(b.date));

---

<section>
    <ScheduleTransition />
    <div class="bg-[#3457C3] pb-16">
        <div class="flex flex-col items-center max-w-screen-2xl w-full mx-auto px-8 sm:px-16">
            <div class="flex justify-between items-end w-full mb-8">
                <Image src={shoppingCart} alt="Shopping cart" class="w-[12.5%]" />
                <Image src={lemonSchedule} alt="Schedule" class="w-md rotate-10" />
            </div>
            <!-- schedule row -->
             <div class="flex justify-between w-full gap-16 lg:gap-32">
                <ScheduleDay day="Saturday" events={saturdayEvents} />
                <ScheduleDay day="Sunday" events={sundayEvents} />
             </div>
        </div>
        <!-- header -->
    </div>
</section>