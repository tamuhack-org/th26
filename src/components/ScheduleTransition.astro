<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { MorphSVGPlugin } from 'gsap/MorphSVGPlugin';

    gsap.registerPlugin(ScrollTrigger, MorphSVGPlugin);

    let mm = gsap.matchMedia(),
        breakpoint = 40; // in rem

    mm.add(
        {
            reduceMotion: '(prefers-reduced-motion: reduce)',
            isMobile: `(max-width: ${breakpoint}rem)`,
            isDesktop: `(min-width: ${breakpoint}rem)`,
        },
        (context) => {
            let { reduceMotion, isMobile, isDesktop } =
                context.conditions as any;

            if (reduceMotion) return;

            const mainTimeline = gsap.timeline({
                scrollTrigger: {
                    // TODO: Change the scroll trigger
                    trigger: '#footer-container',
                    // TODO: change start and end values based on where you want the animation to end on schedule
                    start: 'top 85%',
                    end: isDesktop ? 'bottom bottom' : '50% bottom',
                    scrub: 1,
                },
            });

            mainTimeline
                .to('.wave-start', { morphSVG: '.wave-end' })
                .to('.seal-start', { morphSVG: '.seal-end' }, '<')
                .to('.cat-start', { morphSVG: '.cat-end' }, '<');
        },
    );
</script>
