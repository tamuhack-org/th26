---
import saturdayStarTitle from '@assets/schedule/saturday-star.svg';
import sundayStarTitle from '@assets/schedule/sunday-star.svg';
import packageShadow from '@assets/schedule/package-shadow.svg';
import scheduleFlower from '@assets/schedule/schedule-flower.svg';
import tomatoSticker from '@assets/schedule/tomato-sticker.png';
import plasticWrap from '@assets/schedule/plastic.png';
import Image from 'astro/components/Image.astro';
import type { ScheduleEvent } from './Schedule.astro';

interface Props {
    day: 'Saturday' | 'Sunday';
    events: ScheduleEvent[];
}

const { day, events } = Astro.props;

---

<div class="relative w-fit h-fit">
    <!-- Shadow behind the card -->
    <Image 
        src={packageShadow} 
        alt="Package shadow" 
        class="absolute inset-0 translate-x-[12.5%] translate-y-[10%] w-full h-full object-fill pointer-events-none z-0"
    />
    <!-- plastic wrap -->
    <Image 
        src={plasticWrap} 
        alt="Plastic wrap" 
        class="absolute inset-0 w-full h-full object-fill pointer-events-none z-20 rounded-[36px]"
    />
    {day === 'Sunday' && 
        <Image
            src={tomatoSticker}
            alt="Schedule flower"
            class="absolute -bottom-12 -left-24 w-40 object-fill pointer-events-none z-0 rotate-20 hidden lg:block"
        />
        <Image
            src={scheduleFlower}
            alt="Schedule flower"
            class="absolute -bottom-8 -right-8 w-24 h-24 object-fill pointer-events-none z-20 hidden lg:block"
        />
    }
    <div class="relative z-10 bg-white px-4 py-3 rounded-[36px] h-fit">
        <div class="bg-[#C7B8B8] p-2.5 rounded-[36px]">
            <div class="bg-[#D2C7C7] p-[18px] rounded-[36px]">
                <div class="flex flex-col items-center bg-white rounded-3xl">
                    <!-- title image -->
                    <div class="my-6">
                        <Image
                            src={day === 'Saturday' ? saturdayStarTitle : sundayStarTitle}
                            alt={`${day} Schedule`}
                            class={`w-48 md:w-64 drop-shadow-2xl ${day === 'Saturday' ? '-rotate-2' : 'rotate-2'}`}
                        />
                    </div>
                    <!-- render events -->
                    <div class="w-full px-6 pb-6 space-y-4">
                        {events.map((event: ScheduleEvent) => {
                            const eventDate = new Date(event.date);
                            const options: Intl.DateTimeFormatOptions = {
                                hour: 'numeric',
                                minute: 'numeric',
                                hour12: true,
                                timeZone: 'America/Chicago',
                            };
                            
                            // Convert to lowercase and remove the space
                            const formattedTime = eventDate
                                .toLocaleString('en-US', options)
                                .toLowerCase()      // "9:00 am"
                                .replace(/\s+/g, ''); // "9:00am"

                            return (
                                <div class="flex justify-between gap-4">
                                    <h3 class="text-[20px] font-semibold text-[#77534D] text-nowrap">
                                        {formattedTime}
                                    </h3>
                                    <div class="flex flex-col text-end">
                                        <h3 class="text-[20px] font-semibold text-[#77534D] text-wrap">
                                            {event.eventName}
                                        </h3>
                                        {event.location && (
                                            <p class="mt-1 text-[16px] text-[#77534D]">
                                                {event.location}
                                            </p>
                                        )}
                                    </div>
                                </div>
                            );
                        })}
                </div>
            </div>
        </div>
    </div>
</div>