---
import PostcardBg from '@assets/landing/postcard-bg.svg';
import { Image } from 'astro:assets';
---

<div class="fixed bottom-10 sm:left-10 z-100 w-full flex justify-center sm:justify-start pointer-events-none">
    <div id="menu-container" class="relative pointer-events-auto group">
        <div id="menu-popup" class="md:rotate-3 absolute bottom-full left-1/2 sm:left-4 -translate-x-1/2 sm:translate-x-0 pb-6 invisible">
            <div class="popup-content w-72 md:w-[500px] relative shadow-2xl origin-bottom">
                <Image src={PostcardBg} alt="Postcard border" class="absolute inset-0 w-full h-full object-cover" />
                <div class="relative z-10 p-3">
                    <div class="bg-[#FFFAF0] p-6 flex gap-16 border-2 border-[#77534D]">
                        <nav class="relative flex flex-col gap-3 pl-6">
                            <div id="nav-indicator" class="absolute left-0 top-0 w-4 h-4 rounded-full bg-[#77534D] opacity-0"></div>
                            <a href="/" class="text-lg md:text-xl font-medium text-[#77534D] hover:text-[#D7A953] transition-colors">home</a>
                            <a href="#about" class="text-lg md:text-xl font-medium text-[#77534D] hover:text-[#D7A953] transition-colors">general info</a>
                            <a href="#schedule" class="text-lg md:text-xl font-medium text-[#77534D] hover:text-[#D7A953] transition-colors">schedule</a>
                            <a href="#prizes" class="text-lg md:text-xl font-medium text-[#77534D] hover:text-[#D7A953] transition-colors">prizes</a>
                            <a href="#faq" class="text-lg md:text-xl font-medium text-[#77534D] hover:text-[#D7A953] transition-colors">faq</a>
                            <a href="#resources" class="text-lg md:text-xl font-medium text-[#77534D] hover:text-[#D7A953] transition-colors">resources</a>
                        </nav>
                        <div class="w-0.5 bg-[#77534D] hidden md:block" />
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Button -->
        <button id="menu-btn" class="menu-button md:rotate-3 uppercase cursor-pointer relative z-10 transition-all duration-100">
            Menu & Resources
        </button>
    </div>
</div>

<style>
    .menu-button {
        display: flex;
        padding: 14px 24px;
        justify-content: center;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
        border-radius: 41.438px;
        border: 2.655px solid #77534D;
        background: linear-gradient(282deg, rgba(255, 255, 255, 0.14) 14.64%, rgba(215, 169, 83, 0.14) 89.11%), #FFFAF0;
        box-shadow: 1px 3px 0 0 rgba(255, 255, 255, 0.93) inset, 3px 5px 5px 0 rgba(0, 0, 0, 0.2);
        font-size: 18px;
        font-weight: 500;
        color: rgb(119, 83, 77);
    }
</style>

<script>
    import gsap from 'gsap';

    const container = document.getElementById('menu-container');
    const popup = document.getElementById('menu-popup');
    const popupContent = popup?.querySelector('.popup-content');

    if (container && popup && popupContent) {
        gsap.set(popup, { autoAlpha: 0 });
        gsap.set(popupContent, { scale: 0.8, y: 20 });
        
        const tl = gsap.timeline({ paused: true });
        
        tl.to(popup, { 
            duration: 0.1, 
            autoAlpha: 1,
            ease: "power2.out"
        })
        .to(popupContent, { 
            duration: 0.2, 
            scale: 1, 
            y: 0,
            ease: "back.out(1)" 
        }, "<");

        const openMenu = () => tl.play();
        const closeMenu = () => tl.reverse();

        container.addEventListener('mouseenter', openMenu);
        container.addEventListener('mouseleave', closeMenu);
        
        container.addEventListener('focusin', openMenu);
        container.addEventListener('focusout', (e) => {
            if (!container.contains(e.relatedTarget as Node)) {
                closeMenu();
            }
        });

        // Nav indicator logic
        const nav = popup.querySelector('nav');
        const indicator = document.getElementById('nav-indicator');
        const links = nav?.querySelectorAll('a');

        if (nav && indicator && links) {
            const updateIndicator = (link: HTMLElement) => {
                const relativeY = link.offsetTop + (link.offsetHeight / 2) - (indicator.offsetHeight / 2);
                
                gsap.to(indicator, {
                    y: relativeY,
                    opacity: 1,
                    duration: 0.3,
                    ease: "power2.out"
                });
            };

            links.forEach(link => {
                link.addEventListener('mouseenter', () => updateIndicator(link as HTMLElement));
                link.addEventListener('focus', () => updateIndicator(link as HTMLElement));
            });

            nav.addEventListener('mouseleave', () => {
                gsap.to(indicator, {
                    opacity: 0,
                    duration: 0.2
                });
            });
        }
    }
</script>
