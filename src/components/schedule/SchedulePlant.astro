<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

    gsap.registerPlugin(ScrollTrigger, DrawSVGPlugin);

    // Plant growing animation
    const plantAnimation = () => {
        const mm = gsap.matchMedia();

        mm.add(
            {
                reduceMotion: '(prefers-reduced-motion: reduce)',
                isDesktop: '(min-width: 1024px)',
            },
            (context) => {
                const { reduceMotion, isDesktop } = context.conditions as {
                    reduceMotion: boolean;
                    isDesktop: boolean;
                };

                if (reduceMotion || !isDesktop) return;

                const plantSvg = document.querySelector('#plant-decoration');
                if (!plantSvg) return;

                const stem = plantSvg.querySelector('.plant-stem');
                const leafTop = plantSvg.querySelector('.plant-leaf-top');
                const leavesBranches = plantSvg.querySelector('.plant-leaves-branches');
                const flower = plantSvg.querySelector('.plant-flower');
                const flower2 = plantSvg.querySelector('.plant-flower-2');
                const flower3 = plantSvg.querySelector('.plant-flower-3');

                // Set initial states
                gsap.set([leafTop, flower, flower2, flower3], {
                    opacity: 0,
                    scale: 0,
                    transformOrigin: 'center bottom',
                });

                gsap.set(leavesBranches, {
                    opacity: 0,
                    scale: 0.8,
                    transformOrigin: 'bottom center',
                });

                // Use clip-path animation for the stem growing effect
                gsap.set(stem, {
                    clipPath: 'inset(100% 0 0 0)',
                });

                // Create the scroll-triggered timeline
                const tl = gsap.timeline({
                    scrollTrigger: {
                        trigger: '#plant-decoration',
                        start: 'top 50%',
                        end: 'top 40%',
                        scrub: 1,
                    },
                });

                // Stem grows from bottom to top
                tl.to(
                    stem,
                    {
                        willChange: 'opacity, transform',
                        clipPath: 'inset(0% 0 0 0)',
                        duration: 0.6,
                        ease: 'none',
                    },
                    0
                );

                // Leaves and branches fade in and scale up as stem grows
                tl.to(
                    leavesBranches,
                    {
                        willChange: 'opacity, transform',
                        opacity: 1,
                        scale: 1,
                        duration: 0.4,
                        ease: 'power2.out',
                    },
                    0.2
                );

                // Top leaf appears
                tl.to(
                    leafTop,
                    {
                        willChange: 'opacity, transform',
                        opacity: 1,
                        scale: 1,
                        duration: 0.3,
                        ease: 'back.out(1.7)',
                    },
                    0.3
                );

                // Bottom flower blooms first
                tl.to(
                    flower3,
                    {
                        willChange: 'opacity, transform',
                        opacity: 1,
                        scale: 1,
                        duration: 0.3,
                        ease: 'elastic.out(1, 0.5)',
                    },
                    0.4
                );

                // Middle flower blooms
                tl.to(
                    flower,
                    {
                        willChange: 'opacity, transform',
                        opacity: 1,
                        scale: 1,
                        duration: 0.3,
                        ease: 'elastic.out(1, 0.5)',
                    },
                    0.55
                );

                // Top flower blooms at the very end
                tl.to(
                    flower2,
                    {
                        willChange: 'opacity, transform',
                        opacity: 1,
                        scale: 1,
                        duration: 0.3,
                        ease: 'elastic.out(1, 0.5)',
                    },
                    0.7
                );
            }
        );
    };

    // Initialize animation when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', plantAnimation);
    } else {
        plantAnimation();
    }
</script>