---
import { Image } from 'astro:assets';

export const enum Tier {
    SMALL = 'small',
    MEDIUM = 'medium',
    LARGE = 'large',
    PARTNER = 'partner',
}

interface Props {
    imagePath: string;
    name: string;
    href: string;
    tier: Tier;
}

const { imagePath, name, href, tier } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
    '/src/assets/sponsors/*.{jpeg,jpg,png,gif,svg}',
);

const sponsorsImagePath = '/src/assets/sponsors/';

const fullImagePath = sponsorsImagePath + imagePath;

if (!images[fullImagePath])
    throw new Error(
        `"${fullImagePath}" does not exist in glob: "src/assets/sponsors/*.{jpeg,jpg,png,gif,svg}"`,
    );

let width = '';
let basis = '';
if (tier === Tier.SMALL) {
    basis = 'basis-1/2 md:basis-1/5';
    width = 'w-9/10';
} else if (tier === Tier.PARTNER) {
    basis = 'basis-full md:basis-1/4';
    width = 'w-1/3 md:w-3/5';
} else if (tier === Tier.MEDIUM) {
    basis = 'basis-full md:basis-1/3';
    width = 'w-1/2 md:w-8/10';
} else {
    // if tier is large
    basis = 'basis-full md:basis-1/2';
    width = 'w-3/4';
}
// width overrides
if (name === 'IEEE TAMU') width = 'w-3/5 md:w-full';
---

<a
    href={href}
    target="_blank"
    rel="noreferrer noopener"
    class:list={[
        'flex items-center justify-center',
        basis,
        tier !== Tier.PARTNER ? 'sponsor-svg' : '',
    ]}
>
    <Image
        src={images[fullImagePath]()}
        alt={`${name} homepage`}
        class={width}
    />
</a>
<script>
    import { gsap } from 'gsap';

    gsap.utils.toArray('.sponsor-svg').forEach((item: any) => {
        item.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = item.getBoundingClientRect();
            const relX = e.clientX - (rect.left + rect.width / 2);
            const relY = e.clientY - (rect.top + rect.height / 2);

            gsap.to(item, {
                x: relX * 0.15,
                y: relY * 0.15,
                duration: 0.4,
                ease: 'power2.out',
            });
        });

        item.addEventListener('mouseleave', () => {
            gsap.to(item, {
                x: 0,
                y: 0,
                duration: 0.6,
                ease: 'power3.out',
            });
        });
    });
</script>
