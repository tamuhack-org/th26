---
import Gsap from './Gsap.astro';
import TomatoCat from '@assets/landing/tomato-cat.svg';
import MangoBlob from '@assets/landing/mango-blob.svg';
import BlueberryBlob from '@assets/landing/blueberry-blob.svg';
import BlueberryBunny from '@assets/landing/blueberry-bunny.svg';
import RedBlob from '@assets/landing/red-blob.svg';
import MangoBird from '@assets/landing/mango-bird.svg';
import OrangeBlob from '@assets/landing/orange-blob.svg';

import ApplyMentor from './ApplyMentor.astro';
---

<section
    id="landing"
    class="relative mt-5 grid min-h-svh grid-cols-1 grid-rows-[auto_1fr] sm:grid-cols-2"
>
    <canvas id="snow-canvas"></canvas>
    <div
        class="flex flex-col gap-6 self-start justify-self-center sm:col-start-2 sm:col-end-3 sm:row-start-1 sm:row-end-2 sm:-ml-[15%]"
    >
        <Gsap />
        <div class="ml-[33%] xl:ml-[50%]">
            <ApplyMentor />
        </div>
    </div>
    <div
        class="relative z-0 -mt-24 aspect-square w-full overflow-hidden sm:col-start-1 sm:col-end-2 sm:row-start-1 sm:row-end-3 sm:mt-0 sm:overflow-visible"
        aria-hidden="true"
    >
        <MangoBlob
            class="landing-item absolute top-[18%] left-[45%] hidden h-auto w-1/4 sm:block"
        />
        <BlueberryBlob
            class="landing-item absolute bottom-[52%] left-[5%] hidden h-auto w-1/10 sm:block"
        />
        <OrangeBlob
            class="landing-item absolute bottom-[32%] left-1/2 hidden h-auto w-1/10 sm:block"
        />
        <RedBlob
            class="landing-item absolute bottom-[30%] left-[15%] hidden h-auto w-1/4 sm:block"
        />
        <BlueberryBunny
            class="landing-item draggable absolute bottom-[35%] -left-1 h-auto w-3/10 sm:bottom-[45%] sm:left-[25%]"
        />
        <TomatoCat
            class="landing-item draggable absolute -left-10 h-auto w-7/16"
        />
        <MangoBird
            class="landing-item draggable absolute bottom-[20%] left-[30%] h-auto w-4/9 sm:-right-10 sm:bottom-[12%] sm:left-auto"
        />
    </div>
</section>

<script>
    import { gsap } from 'gsap';

    gsap.utils.toArray('.landing-item:not(.draggable)').forEach((item: any) => {
        item.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = item.getBoundingClientRect();
            const relX = e.clientX - (rect.left + rect.width / 2);
            const relY = e.clientY - (rect.top + rect.height / 2);

            gsap.to(item, {
                x: relX * 0.15,
                y: relY * 0.15,
                duration: 0.4,
                ease: 'power2.out',
            });
        });

        item.addEventListener('mouseleave', () => {
            gsap.to(item, {
                x: 0,
                y: 0,
                duration: 0.6,
                ease: 'power3.out',
            });
        });
    });

    const draggables = Array.from(document.querySelectorAll('.draggable'));
    const state = new Map();

    let mouseX = 0;
    let mouseY = 0;
    let draggedItem: Element | null = null;
    let dragOffset = { x: 0, y: 0 };

    draggables.forEach((el) => {
        const rect = el.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;

        state.set(el, {
            x: 0,
            y: 0,
            vx: 0,
            vy: 0,
            originX: centerX,
            originY: centerY,
        });

        el.addEventListener('mousedown', (e: any) => {
            e.preventDefault(); // Prevent text selection
            draggedItem = el;

            const s = state.get(el);
            const currentCenterX = s.originX + s.x;
            const currentCenterY = s.originY + s.y;

            dragOffset.x = currentCenterX - e.clientX;
            dragOffset.y = currentCenterY - e.clientY;

            // pop grabbing anim
            gsap.to(el, { scale: 1.1, duration: 0.2, ease: 'back.out(1.7)' });
        });

        // grab cursor
        (el as HTMLElement).style.cursor = 'grab';
    });

    window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
    });

    window.addEventListener('mouseup', () => {
        if (draggedItem) {
            gsap.to(draggedItem, {
                scale: 1,
                duration: 0.2,
                ease: 'power2.out',
            });
            draggedItem = null;
        }
    });

    gsap.ticker.add(() => {
        draggables.forEach((el) => {
            const s = state.get(el);

            if (el === draggedItem) {
                const targetX = mouseX + dragOffset.x - s.originX;
                const targetY = mouseY + dragOffset.y - s.originY;

                const k = 0.08;
                const ax = (targetX - s.x) * k;
                const ay = (targetY - s.y) * k;

                s.vx += ax;
                s.vy += ay;
            } else {
                const k = 0.02;
                s.vx += (0 - s.x) * k;
                s.vy += (0 - s.y) * k;
            }

            s.vx *= 0.85;
            s.vy *= 0.85;

            s.x += s.vx;
            s.y += s.vy;

            gsap.set(el, { x: s.x, y: s.y });
        });
    });
</script>

<script>
    (function () {
        var requestAnimationFrame =
            window.requestAnimationFrame ||
            (window as any).mozRequestAnimationFrame ||
            (window as any).webkitRequestAnimationFrame ||
            (window as any).msRequestAnimationFrame ||
            function (callback: FrameRequestCallback) {
                window.setTimeout(callback, 1000 / 60);
            };
        window.requestAnimationFrame = requestAnimationFrame;
    })();

    interface Flake {
        speed: number;
        velY: number;
        velX: number;
        x: number;
        y: number;
        size: number;
        stepSize: number;
        step: number;
        opacity: number;
    }

    const landingSection = document.getElementById('landing') as HTMLElement;
    const canvas = document.getElementById('snow-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const flakeCount = 100;
    let mX = -100;
    let mY = -100;
    const flakes: Flake[] = [];

    function resizeCanvas() {
        canvas.width = landingSection.offsetWidth;
        canvas.height = landingSection.offsetHeight;
    }

    resizeCanvas();

    function snow() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        for (let i = 0; i < flakeCount; i++) {
            const flake = flakes[i];
            const x = mX;
            const y = mY;
            const minDist = 150;
            const x2 = flake.x;
            const y2 = flake.y;

            const dist = Math.sqrt((x2 - x) * (x2 - x) + (y2 - y) * (y2 - y));

            if (dist < minDist) {
                const force = minDist / (dist * dist);
                const xcomp = (x - x2) / dist;
                const ycomp = (y - y2) / dist;
                const deltaV = force / 2;

                flake.velX -= deltaV * xcomp;
                flake.velY -= deltaV * ycomp;
            } else {
                flake.velX *= 0.98;
                if (flake.velY <= flake.speed) {
                    flake.velY = flake.speed;
                }
                flake.velX += Math.cos((flake.step += 0.05)) * flake.stepSize;
            }

            ctx.fillStyle = 'rgba(255,255,255,' + flake.opacity + ')';
            flake.y += flake.velY;
            flake.x += flake.velX;

            if (flake.y >= canvas.height || flake.y <= 0) {
                reset(flake);
            }

            if (flake.x >= canvas.width || flake.x <= 0) {
                reset(flake);
            }

            ctx.beginPath();
            ctx.arc(flake.x, flake.y, flake.size, 0, Math.PI * 2);
            ctx.fill();
        }
        requestAnimationFrame(snow);
    }

    function reset(flake: Flake) {
        flake.x = Math.floor(Math.random() * canvas.width);
        flake.y = 0;
        flake.size = Math.random() * 3 + 2;
        flake.speed = Math.random() * 1 + 0.5;
        flake.velY = flake.speed;
        flake.velX = 0;
        flake.opacity = Math.random() * 0.5 + 0.3;
    }

    function init() {
        for (let i = 0; i < flakeCount; i++) {
            const x = Math.floor(Math.random() * canvas.width);
            const y = Math.floor(Math.random() * canvas.height);
            const size = Math.random() * 3 + 2;
            const speed = Math.random() * 1 + 0.5;
            const opacity = Math.random() * 0.5 + 0.3;

            flakes.push({
                speed: speed,
                velY: speed,
                velX: 0,
                x: x,
                y: y,
                size: size,
                stepSize: Math.random() / 30,
                step: 0,
                opacity: opacity,
            });
        }

        snow();
    }

    landingSection.addEventListener('mousemove', function (e) {
        const rect = landingSection.getBoundingClientRect();
        mX = e.clientX - rect.left;
        mY = e.clientY - rect.top;
    });

    window.addEventListener('resize', function () {
        resizeCanvas();
    });

    init();
</script>

<style>
    #snow-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 9999;
    }
</style>
