---
import Gsap from './Gsap.astro';
import TomatoCat from '@assets/landing/tomato-cat.svg';
import MangoBlob from '@assets/landing/mango-blob.svg';
import BlueberryBlob from '@assets/landing/blueberry-blob.svg';
import BlueberryBunny from '@assets/landing/bluebery-bunny.svg';
import RedBlob from '@assets/landing/red-blob.svg';
import MangoBird from '@assets/landing/mango-bird.svg';
import OrangeBlob from '@assets/landing/orange-blob.svg';

import ApplyMentor from './ApplyMentor.astro';
---

<div class="grid grid-cols-1 grid-rows-2 xl:grid-cols-2">
    <div
        class="self-end justify-self-center -ml-[15%] xl:col-start-2 xl:col-end-3 xl:row-start-1 xl:row-end-2"
    >
        <Gsap />
    </div>
    <div class="xl:col-start-2 xl:col-end-3 xl:row-start-2 xl:row-end-4 justify-self-center ml-25 mt-7 sm:mt-10">
        <ApplyMentor />
    </div>
    <div
        class="relative z-0 -mt-20 aspect-square w-full overflow-hidden xl:col-start-1 xl:col-end-2 xl:row-start-1 xl:row-end-3 xl:mt-0 xl:overflow-visible"
    >
        <TomatoCat class="absolute -left-12 h-auto w-5/12 xl:-left-8" />
        <MangoBlob class="absolute top-[18%] left-[45%] h-auto w-1/4" />
        <BlueberryBlob class="absolute bottom-[52%] left-[5%] h-auto w-1/10" />
        <BlueberryBunny
            class="absolute bottom-[45%] left-[25%] z-50 h-auto w-2/7"
        />
        <OrangeBlob class="absolute bottom-[32%] left-1/2 h-auto w-1/10" />
        <RedBlob class="absolute bottom-[30%] left-[15%] h-auto w-1/4" />
        <MangoBird class="absolute -right-10 bottom-[12%] h-auto w-4/9" />
    </div>
</div>
