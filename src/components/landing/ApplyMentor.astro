---
import { Picture } from 'astro:assets';
import applyButton from '@assets/apply-button.png';
import mentorButton from '@assets/mentor-button.png';
---

<div class="flex gap-3">
	<a
		class="cursor-pointer"
		href="https://start.tamuhack.com"
		target="_blank"
		rel="noopener"
	>
		<Picture
			src={applyButton}
			alt="Apply button"
			formats={['avif', 'webp', 'png']}
			class="w-25 sm:w-30"
		/>
	</a>
	<a
		class="cursor-pointer mt-12 sm:mt-15 "
		href="https://tamuhack.org/mentor"
		target="_blank"
		rel="noopener"
	>
		<Picture
			src={mentorButton}
			alt="Mentor button"
			formats={['avif', 'webp', 'png']}
			class="w-25 sm:w-30"
		/>
	</a>
</div>
