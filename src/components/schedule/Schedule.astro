---
import ScheduleTransition from "@components/ScheduleTransition.astro";
import shoppingCart from "@assets/schedule/cart.svg";
import lemonSchedule from "@assets/schedule/lemon-schedule.png";
import packageShadow from "@assets/schedule/package-shadow.svg";
import plasticWrap from "@assets/schedule/plastic.png";
import Image from "astro/components/Image.astro";
import ScheduleDay from "./ScheduleDay.astro";

export const prerender = false

export interface ScheduleEvent {
    date: string;
    [key: string]: unknown;
}

const response = await fetch('https://team.tamuhack.org/api/hh25');
const data: ScheduleEvent[] = await response.json();

// Filter events by day based on the date field
const saturdayEvents = data
    .filter((item: ScheduleEvent) => {
        const date = new Date(item.date);
        const dayInCST = new Date(
            date.toLocaleString('en-US', { timeZone: 'America/Chicago' }),
        ).getDay();
        return dayInCST === 6; // 6 = Saturday
    })
    .sort((a: ScheduleEvent, b: ScheduleEvent) => new Date(a.date).getTime() - new Date(b.date).getTime());

const sundayEvents = data
    .filter((item: ScheduleEvent) => {
        const date = new Date(item.date);
        const dayInCST = new Date(
            date.toLocaleString('en-US', { timeZone: 'America/Chicago' }),
        ).getDay();
        return dayInCST === 0; // 0 = Sunday
    })
    .sort((a: ScheduleEvent, b: ScheduleEvent) => new Date(a.date).getTime() - new Date(b.date).getTime());

---

<section>
    <ScheduleTransition />
    <div class="bg-[#3457C3] pb-16">
        <div class="flex flex-col items-center max-w-screen-2xl w-full mx-auto px-8 sm:px-16">
            <div class="flex justify-between items-end w-full mb-12">
                <Image src={shoppingCart} alt="Shopping cart" class="w-[15%]" />
                <Image src={lemonSchedule} alt="Schedule" class="w-md rotate-10" />
            </div>
            <!-- schedule row -->
             <div class="flex justify-between w-full gap-16 lg:gap-32">
                <ScheduleDay day="Saturday" events={saturdayEvents} />
                <div class="flex flex-col gap-16">
                    <ScheduleDay day="Sunday" events={sundayEvents} />
                    <!-- Empty container element -->
                    <div class="relative w-full h-fit">
                        <!-- Shadow behind the card -->
                        <Image 
                            src={packageShadow} 
                            alt="Package shadow" 
                            class="absolute inset-0 translate-x-[12.5%] translate-y-[10%] w-full h-full object-fill pointer-events-none z-0"
                        />
                        <Image 
                            src={plasticWrap} 
                            alt="Plastic wrap" 
                            class="absolute inset-0 w-full h-full object-fill pointer-events-none z-20 rounded-[36px]"
                        />
                        <div class="relative z-10 bg-white px-4 py-3 rounded-[36px] h-fit">
                            <div class="bg-[#C7B8B8] p-2.5 rounded-[36px]">
                                <div class="bg-[#D2C7C7] p-[18px] rounded-[36px]">
                                    <div class="flex flex-col items-center bg-white rounded-3xl min-h-32 min-w-48">
                                        <!-- Empty content -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
             </div>
             <div class="flex items-center justify-center w-full">
                <Image src={shoppingCart} alt="Shopping cart" class="w-[60%] rotate-180 mt-20" />
             </div>
        </div>
    </div>
</section>