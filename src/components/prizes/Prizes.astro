---
import Receipt from './Receipt.astro';
import { prizeslist } from './prizes.ts';
import Marquee from './Marquee.astro';
const softwarePrizes = [
    prizeslist['first-place-software'],
    prizeslist['second-place-software'],
    prizeslist['third-place-software'],
    prizeslist['best-design'],
    prizeslist['best-beginner-software'],
    prizeslist['american-airlines'],
    prizeslist['northmark'],
    prizeslist['usaa'],
    prizeslist['capital-one'],
    prizeslist['toyota'],
    prizeslist['msy'],
    prizeslist['figma'],
];
const hardwarePrizes = [
    prizeslist['first-place-hardware'],
    prizeslist['second-place-hardware'],
    prizeslist['third-place-hardware'],
    prizeslist['iot'],
    prizeslist['medical-device'],
    prizeslist['best-beginner-hardware'],
];
---

<section id="prizes">
    <Marquee word={'now scanning'} />
    <!-- Max width based roughly off two receipts  -->
    <div
        class="mx-auto max-w-208 bg-[#554948] px-2 py-10 md:border-r-20 md:border-l-20 md:border-[#8c8281] md:px-6"
    >
        <div class="software-prizes">
            <div class="flex justify-center">
                <div
                    class="my-5 rotate-3 border-r-20 border-l-20 border-[#8c8281] bg-[#E3442F] px-10 py-2 drop-shadow-lg md:px-40"
                >
                    <h2
                        class="text-center text-xl font-bold text-white md:text-2xl"
                    >
                        Software Prizes
                    </h2>
                </div>
            </div>
            <div class="flex flex-col items-stretch gap-6 md:gap-0">
                {
                    softwarePrizes.map((prize, index) => (
                        <div
                            class:list={[
                                'prize-wrapper flex md:-mt-12 md:first:mt-0',
                                index % 2 === 0
                                    ? 'md:-mr-16 md:justify-end'
                                    : 'md:-ml-16 md:justify-start',
                            ]}
                            data-animate-from={
                                index % 2 === 0 ? 'right' : 'left'
                            }
                        >
                            <Receipt prize={prize} />
                        </div>
                    ))
                }
            </div>
        </div>
        <div class="hardware-prizes mt-10">
            <div class="flex justify-center">
                <div
                    class="my-5 -rotate-3 border-r-20 border-l-20 border-[#8c8281] bg-white px-10 py-2 drop-shadow-lg md:px-40"
                >
                    <h2
                        class="text-center text-xl font-bold text-[#3457C3] md:text-2xl"
                    >
                        Hardware Prizes
                    </h2>
                </div>
            </div>
            <div class="flex flex-col items-stretch gap-6 md:gap-0">
                {
                    hardwarePrizes.map((prize, index) => (
                        <div
                            class:list={[
                                'prize-wrapper flex md:-mt-12 md:first:mt-0',
                                index % 2 === 0
                                    ? 'md:-mr-16 md:justify-end'
                                    : 'md:-ml-16 md:justify-start',
                            ]}
                            data-animate-from={
                                index % 2 === 0 ? 'right' : 'left'
                            }
                        >
                            <Receipt prize={prize} />
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
    <Marquee word={'end scanning'} />
</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        const prizeWrappers =
            document.querySelectorAll<HTMLElement>('.prize-wrapper');

        prizeWrappers.forEach((wrapper) => {
            const direction = wrapper.dataset.animateFrom;
            const xOffset = direction === 'right' ? 80 : -80;
            const rotation = direction === 'right' ? 3 : -3;

            gsap.set(wrapper, {
                x: xOffset,
                rotation: rotation,
                scale: 0.95,
                opacity: 0,
            });

            gsap.to(wrapper, {
                x: 0,
                rotation: 0,
                scale: 1,
                opacity: 1,
                duration: 0.5,
                ease: 'power2.out',
                scrollTrigger: {
                    trigger: wrapper,
                    start: 'top 85%',
                },
            });
        });
    });
</script>
