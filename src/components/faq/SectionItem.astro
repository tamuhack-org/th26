---
import QuestionItem from './QuestionItem.astro';

interface Props {
    title: string;
    questions: { question: string; answers: string[] }[];
}

const { title, questions } = Astro.props;
---

<div class="bg-brown anim-line-2 h-1 w-full" aria-hidden="true"></div>
<div class="py-2">
    <div
        class="anim-text-2 flex justify-between pb-3 text-2xl font-black sm:text-3xl"
    >
        <h2>{title}</h2>
        <div aria-hidden="true">{questions.length}%</div>
    </div>
    <div class="ml-9">
        {questions.map((question) => <QuestionItem question={question} />)}
    </div>
</div>
