<script>
    import gsap from 'gsap';
    console.clear();

    const sealsContainer = document.querySelector('#seals');
    const smallSeals = document.querySelectorAll('.seal-small');
    const speechBubble = document.querySelector('.speech-bubble');

    if (sealsContainer && smallSeals.length > 0 && speechBubble) {
        sealsContainer.addEventListener('mouseenter', () => {
            gsap.matchMedia().add(
                '(prefers-reduced-motion: no-preference)',
                () => {
                    smallSeals.forEach((seal, index) => {
                        gsap.to(seal, {
                            y: -15,
                            duration: 0.25,
                            ease: 'power2.out',
                            yoyo: true,
                            repeat: -1,
                            repeatDelay: 0.1,
                            delay: index * 0.1,
                        });
                    });
                },
            );

            gsap.to(speechBubble, {
                x: 5,
                y: -3,
                rotation: 2,
                duration: 0.6,
                ease: 'power1.inOut',
                yoyo: true,
                repeat: -1,
            });
        });

        sealsContainer.addEventListener('mouseleave', () => {
            smallSeals.forEach((seal) => {
                gsap.killTweensOf(seal);
                gsap.to(seal, {
                    y: 0,
                    duration: 0.3,
                    ease: 'power2.out',
                });
            });

            gsap.killTweensOf(speechBubble);
            gsap.to(speechBubble, {
                x: 0,
                y: 0,
                rotation: 0,
                duration: 0.3,
                ease: 'power2.out',
            });
        });
    }
</script>
