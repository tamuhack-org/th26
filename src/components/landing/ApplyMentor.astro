---
import applyButton from '@assets/landing/apply-button.png';
import mentorButton from '@assets/landing/mentor-button.png';
import Sticker from './Sticker.astro';
---

<div class="apply-mentor-container relative z-50 flex gap-3">
    <div class="cursor-not-allowed opacity-50">
        <span class="sr-only">Apply</span>
        <Sticker
            imageSrc={applyButton}
            label="Apply button"
            peelDirection={-25}
            backColor="#DEC299"
            class="pointer-events-none w-28 xl:w-36"
        />
    </div>
    <div class="mt-12 cursor-not-allowed opacity-50 xl:mt-15">
        <span class="sr-only">Mentor</span>
        <Sticker
            imageSrc={mentorButton}
            label="Mentor button"
            peelDirection={-25}
            backColor="#DEC299"
            class="pointer-events-none w-28 xl:w-36"
        />
    </div>
</div>

<script>
    import { gsap } from 'gsap';

    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        gsap.fromTo(
            '.apply-mentor-container > *',
            { scale: 1.3, opacity: 0 },
            {
                scale: 1,
                duration: 0.3,
                ease: 'power2.out',
                opacity: 0.5,
                rotate: -8,
                delay: 2.35,
                stagger: 0.2,
            },
        );
    });
</script>
