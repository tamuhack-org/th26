---
import Blueberry from '../assets/landing/blueberry.svg';
import Strawberry from '../assets/landing/strawberry.svg';
---

<div id="landing-container">
    <h1 class="sr-only">TAMUhack 2026</h1>
    <div id="heading__tamuhack">
        <div class="line line-1">
            <span class="char char-t">t</span>
            <img class="char char-a-strawberry" src={Strawberry.src} alt="A" />
            <span class="char char-m">m</span>
            <span class="char char-u">u</span>
        </div>
        <div class="line line-2">
            <span class="char char-h">h</span>
            <span class="char char-c">a</span>
            <img class="char char-a-blueberry" src={Blueberry.src} alt="a" />
            <span class="char char-k will-change-transform">k</span>
        </div>
    </div>
</div>

<style>
    #landing-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
    }

    #heading__tamuhack {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        opacity: 1;
    }

    .line {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .char {
        display: inline-block;
        font-size: 6rem;
        font-weight: bold;
        line-height: 1;
    }

    .char-a-strawberry,
    .char-a-blueberry {
        height: 8rem;
        margin-inline: -1rem;
        width: auto;
    }

    @media (max-width: 768px) {
        .char {
            font-size: 4rem;
        }

        .char-a-strawberry,
        .char-a-blueberry {
            height: 4rem;
        }
    }
</style>

<script>
    import gsap from 'gsap';
    console.clear();

    const defaults = {
        ease: 'power2.out',
        duration: 1,
    };

    // Animation for T - slide from bottom
    const animateT = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-t', { yPercent: 100, opacity: 0 });
        return tl;
    };

    // Animation for A (strawberry) - bounce from top
    const animateStrawberry = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-a-strawberry', {
            yPercent: -100,
            rotation: -360,
            ease: 'back.out(1.4)',
        });
        return tl;
    };

    // Animation for M - slide from right
    const animateM = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-m', {
            opacity: 0,
            xPercent: 100,
        });
        return tl;
    };

    // Animation for U - fade in
    const animateU = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-u', { opacity: 0 });
        return tl;
    };

    // Animation for h - 3D flip
    const animateH = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-h', {
            rotationY: -180,
            scale: 0,
        });
        return tl;
    };

    // Animation for a (blueberry) - spin and bounce
    const animateBlueberry = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-a-blueberry', {
            autoAlpha: 0,
            rotation: -360,
            scale: 0,
            ease: 'elastic.out(1, 0.4)',
            duration: 1,
        });
        return tl;
    };

    // Animation for c - slide from right
    const animateC = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-c', {
            opacity: 0,
            xPercent: 100,
        });
        return tl;
    };

    // Animation for k - spin
    const animateK = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-k', {
            autoAlpha: 0,
            rotation: -120,
            ease: 'elastic.out(1, 0.4)',
            duration: 2,
        });
        return tl;
    };

    // Main timeline
    const mainTimeline = gsap.timeline({ defaults });

    // Set initial state
    mainTimeline.set('#heading__tamuhack', { autoAlpha: 1 });

    // Add all character animations with time offsets for overlapping animations
    mainTimeline.add(animateT());
    mainTimeline.add(animateStrawberry(), 0.3);
    mainTimeline.add(animateM(), 0.5);
    mainTimeline.add(animateU(), 0.7);
    mainTimeline.add(animateH(), 0.9);
    mainTimeline.add(animateBlueberry(), 1.1);
    mainTimeline.add(animateC(), 1.3);
    mainTimeline.add(animateK(), 1.5);
</script>
