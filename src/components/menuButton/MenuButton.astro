---
import PostcardBg from '@assets/landing/postcard-bg.svg';
import strawberry from '@assets/genInfo/strawberry.svg';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Resources from './Resources.astro';
---

<div
    class="pointer-events-none fixed bottom-6 z-100 flex w-full justify-center sm:bottom-14 sm:left-14 sm:justify-start"
>
    <div id="menu-container" class="group pointer-events-auto relative">
        <!-- Button -->
        <button
            id="menu-btn"
            class="menu-button relative z-10 cursor-pointer uppercase transition-all duration-100 hover:scale-105 md:rotate-3"
        >
            Menu & Resources
        </button>
        <div
            id="menu-popup"
            class="invisible absolute bottom-full left-1/2 -translate-x-1/2 pb-6 sm:left-4 sm:translate-x-0 md:rotate-3"
        >
            <div
                class="popup-content relative w-72 origin-bottom md:w-[500px] md:shadow-2xl"
            >
                <Image
                    src={PostcardBg}
                    alt="Postcard border"
                    class="absolute inset-0 hidden h-full w-full object-cover md:block"
                    aria-hidden="true"
                    loading={'eager'}
                />
                <div class="relative z-10 md:p-3">
                    <div
                        class="relative overflow-hidden rounded-4xl border-2 border-[#77534D] bg-[#FFFAF0] shadow-2xl md:rounded-none md:shadow-none"
                    >
                        <div id="views-wrapper" class="relative w-full">
                            <div
                                id="nav-view"
                                class="absolute top-0 left-0 flex w-full gap-6 p-6"
                            >
                                <nav class="relative flex flex-col gap-3 pl-6">
                                    <div
                                        id="nav-indicator"
                                        class="absolute top-0 left-0 opacity-0"
                                    >
                                        <img
                                            src={strawberry.src}
                                            class="h-auto w-4"
                                            alt="Strawberry"
                                            aria-hidden="true"
                                        />
                                    </div>
                                    <a href="/#" class="enabled-link">home</a>
                                    <a href="#general-info" class="enabled-link"
                                        >general info</a
                                    >
                                    <a href="#faq" class="enabled-link">faq</a>
                                    <a href="#schedule" class="enabled-link"
                                        >schedule</a
                                    >
                                    <a href="#prizes" class="enabled-link"
                                        >prizes</a
                                    >
                                    <button
                                        id="btn-to-resources"
                                        class="cursor-pointer text-left text-lg font-bold text-[#3457C3] md:hidden"
                                        aria-label="View resources"
                                    >
                                        <span
                                            class="underline underline-offset-4"
                                            >resources</span
                                        >
                                        <Icon
                                            name="tabler:arrow-narrow-right"
                                            class="inline fill-[#3457C3] text-3xl"
                                        />
                                    </button>
                                </nav>
                                <div class="hidden w-0.5 bg-[#77534D] md:block h-57">
                                </div>
                                <div class="hidden md:block">
                                    <Resources />
                                </div>
                            </div>
                            <div
                                id="resource-view"
                                class="invisible absolute top-0 left-0 flex w-full flex-col px-4 py-6 opacity-0"
                                aria-hidden="true"
                            >
                                <Resources />
                                <button
                                    id="btn-back"
                                    class="text-brown mb-4 cursor-pointer self-start text-lg font-bold underline underline-offset-4 transition-colors hover:text-[#d7a95d]"
                                >
                                    <Icon
                                        name="tabler:arrow-narrow-left"
                                        class="inline fill-[#3457C3] text-2xl"
                                    />back
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .menu-button {
        display: flex;
        padding: 14px 24px;
        justify-content: center;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
        border-radius: 41.438px;
        border: 2.655px solid #77534d;
        background:
            linear-gradient(
                282deg,
                rgba(255, 255, 255, 0.14) 14.64%,
                rgba(215, 169, 83, 0.14) 89.11%
            ),
            #fffaf0;
        box-shadow:
            1px 3px 0 0 rgba(255, 255, 255, 0.93) inset,
            3px 5px 5px 0 rgba(0, 0, 0, 0.2);
        font-size: 18px;
        font-weight: 500;
        color: rgb(119, 83, 77);
    }

    a {
        font-size: var(--text-lg);
        line-height: var(--text-lg--line-height);
        font-weight: 500;
        color: var(--color-brown);
        @media (width >= 48rem) {
            font-size: var(--text-xl);
            line-height: var(--text-xl--line-height);
        }
    }

    .enabled-link {
        transition: color var(--default-transition-duration)
            var(--default-transition-timing-function);

        &:hover {
            color: #d7a95d;
        }
    }

    .disabled-link {
        pointer-events: none;
        opacity: 50%;
    }
</style>

<script>
    import gsap from 'gsap';

    const container = document.getElementById('menu-container');
    const popup = document.getElementById('menu-popup');
    const popupContent = popup?.querySelector('.popup-content');
    const menuBtn = document.getElementById('menu-btn');

    const viewsWrapper = document.getElementById('views-wrapper');
    const navView = document.getElementById('nav-view');
    const resourceView = document.getElementById('resource-view');

    const btnToResources = document.getElementById('btn-to-resources');
    const btnBack = document.getElementById('btn-back');

    if (
        container &&
        popup &&
        popupContent &&
        menuBtn &&
        viewsWrapper &&
        navView &&
        resourceView &&
        btnToResources &&
        btnBack
    ) {
        const initialHeight = navView.offsetHeight;
        gsap.set(viewsWrapper, { height: initialHeight });

        const resourceViewInitial = {
            autoAlpha: 0,
            visibility: 'hidden',
        };

        gsap.set(popup, { autoAlpha: 0 });
        gsap.set(popupContent, { scale: 0.8, y: 20 });
        gsap.set(resourceView, { ...resourceViewInitial });

        let isMenuOpen = false;
        let isClickedOpen = false;
        let isTransitioningViews = false;

        const tl = gsap.timeline({ paused: true });
        tl.to(popup, {
            duration: 0.1,
            autoAlpha: 1,
            ease: 'power2.out',
        }).to(
            popupContent,
            {
                duration: 0.2,
                scale: 1,
                y: 0,
                ease: 'back.out(1)',
            },
            '<',
        );

        const switchView = (target: 'resources' | 'nav') => {
            if (isTransitioningViews) return;
            isTransitioningViews = true;

            const isToResources = target === 'resources';
            const outView = isToResources ? navView : resourceView;
            const inView = isToResources ? resourceView : navView;
            const focusTarget = isToResources ? btnBack : btnToResources;

            const targetHeight = inView.offsetHeight;

            const switchTl = gsap.timeline({
                onComplete: () => {
                    isTransitioningViews = false;
                    outView.setAttribute('aria-hidden', 'true');
                    inView.setAttribute('aria-hidden', 'false');
                    focusTarget.focus();
                },
            });

            // fade out curr text
            switchTl.to(outView, {
                autoAlpha: 0,
                duration: 0.1,
                ease: 'power1.out',
            });

            // resize wrapper
            switchTl.to(viewsWrapper, {
                height: targetHeight,
                duration: 0.2,
                ease: 'power2.inOut',
            });

            // fade in new text
            switchTl.fromTo(
                inView,
                { autoAlpha: 0 },
                {
                    autoAlpha: 1,
                    duration: 0.1,
                    ease: 'power1.in',
                },
            );
        };

        const openMenu = () => {
            if (isMenuOpen) return;

            gsap.set(navView, { autoAlpha: 1, visibility: 'visible' });
            gsap.set(resourceView, { ...resourceViewInitial });
            gsap.set(viewsWrapper, { height: navView.offsetHeight });

            tl.play();
            menuBtn.classList.add('scale-105');
            menuBtn.setAttribute('aria-expanded', 'true');
            isMenuOpen = true;
        };

        const closeMenu = () => {
            if (!isMenuOpen) return;
            tl.reverse();
            isClickedOpen = false;
            isMenuOpen = false;
            menuBtn.classList.remove('scale-105');
            menuBtn.setAttribute('aria-expanded', 'false');
        };

        btnToResources.addEventListener('click', (e) => {
            e.stopPropagation();
            switchView('resources');
        });
        btnBack.addEventListener('click', (e) => {
            e.stopPropagation();
            switchView('nav');
        });

        menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (isClickedOpen) {
                closeMenu();
            } else {
                openMenu();
                isClickedOpen = true;
            }
        });

        const isHoverable = window.matchMedia('(hover: hover)').matches;

        if (isHoverable) {
            container.addEventListener('mouseenter', openMenu);
            container.addEventListener('mouseleave', () => {
                if (!isClickedOpen) {
                    closeMenu();
                }
            });
        }

        container.addEventListener('focusin', openMenu);
        container.addEventListener('focusout', (e) => {
            if (isTransitioningViews) return;
            if (
                !isClickedOpen &&
                !container.contains(e.relatedTarget as Node)
            ) {
                closeMenu();
            }
        });

        document.addEventListener('click', (e) => {
            if (isClickedOpen && !container.contains(e.target as Node)) {
                closeMenu();
            }
        });

        // --- Nav Indicator Logic ---
        const nav = popup.querySelector('nav');
        const indicator = document.getElementById('nav-indicator');
        const links = nav?.querySelectorAll('a');

        if (nav && indicator && links) {
            const updateIndicator = (link: HTMLElement) => {
                const relativeY =
                    link.offsetTop +
                    link.offsetHeight / 2 -
                    indicator.offsetHeight / 2;

                gsap.to(indicator, {
                    y: relativeY,
                    opacity: 1,
                    duration: 0.3,
                    ease: 'power2.out',
                });
            };

            links.forEach((link) => {
                if (isHoverable) {
                    link.addEventListener('mouseenter', () =>
                        updateIndicator(link as HTMLElement),
                    );
                }
                link.addEventListener('focus', () =>
                    updateIndicator(link as HTMLElement),
                );
                link.addEventListener('click', () =>
                    updateIndicator(link as HTMLElement),
                );
            });

            nav.addEventListener('mouseleave', () => {
                gsap.to(indicator, {
                    opacity: 0,
                    duration: 0.2,
                });
            });
        }
    }
</script>
