---
import Blueberry from '@assets/landing/blueberry.svg';
import Strawberry from '@assets/landing/strawberry.svg';
import Banana from '@assets/landing/banana.svg';

import BgImage from '@assets/landing/heading_bg.svg';
import { getImage } from 'astro:assets';

const ellipse = await getImage({ src: BgImage });
---

<div class="flex items-center justify-center">
    <h1 class="sr-only">TAMUhack 2026</h1>
    <div
        id="heading__tamuhack"
        class="font-family-bbh text-brown grid grid-cols-[1fr_auto] content-center gap-x-2 text-6xl leading-none tracking-wider uppercase opacity-100 sm:gap-x-4 xl:text-8xl 2xl:text-9xl"
        style={`
          background-image: url(${ellipse.src});
          background-repeat: no-repeat;
          background-size: contain;
          background-position: center;
        `}
    >
        <div
            class="row-start-1 row-end-2 -mb-[.1em] flex items-center justify-center"
            aria-hidden="true"
        >
            <span class="char char-t inline-block leading-none font-bold"
                >t</span
            >
            <img
                class="char char-a-strawberry inline-block w-auto mr-2"
                src={Strawberry.src}
                alt="A"
            />
            <span class="char char-m inline-block leading-none font-bold"
                >m</span
            >
            <span class="char char-u inline-block leading-none font-bold"
                >u</span
            >
        </div>
        <div
            class="row-start-2 row-end-3 flex items-center justify-between"
            aria-hidden="true"
        >
            <span class="char char-h inline-block leading-none font-bold"
                >h</span
            >
            <span class="char char-a inline-block leading-none font-bold"
                >a</span
            >
            <img class="char char-c-banana w-auto" src={Banana.src} alt="c" />
            <span
                class="char char-k inline-block leading-none font-bold will-change-transform"
                >k</span
            >
        </div>
        <div
            class="font-family-stack row-start-3 row-end-4 text-right text-lg/snug font-semibold tracking-normal lowercase xl:text-2xl/9 2xl:text-4xl/12"
        >
            <p>January 24-25</p>
            <p>MSC 2500</p>
        </div>
        <div
            class="row-start-2 row-end-3 flex items-center"
            id="twenty"
            aria-hidden="true"
        >
            2<img
                class="char char-0-blueberry inline-block w-auto"
                src={Blueberry.src}
                alt="0"
            />
        </div>
        <div
            class="col-start-2 row-start-3 row-end-4 -mt-[.1em]"
            id="twenty-six"
            aria-hidden="true"
        >
            26
        </div>
    </div>
</div>

<style>
    .char-a-strawberry,
    .char-c-banana,
    .char-0-blueberry {
        height: 0.75em;
    }
</style>

<script>
    import gsap from 'gsap';
    console.clear();

    const defaults = {
        ease: 'power2.out',
        duration: 1,
    };

    // Animation for T - slide from bottom
    const animateT = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-t', { yPercent: 100, opacity: 0 });
        return tl;
    };

    // Animation for A (strawberry) - bounce from top
    const animateStrawberry = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-a-strawberry', {
            yPercent: -100,
            rotation: -360,
            ease: 'back.out(1.4)',
        });
        return tl;
    };

    // Animation for M - slide from right
    const animateM = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-m', {
            opacity: 0,
            xPercent: 100,
        });
        return tl;
    };

    // Animation for U - fade in
    const animateU = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-u', { opacity: 0 });
        return tl;
    };

    // Animation for h - 3D flip
    const animateH = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-h', {
            rotationY: -180,
            scale: 0,
        });
        return tl;
    };

    // Animation for a - slide from right
    const animateA = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-a', {
            opacity: 0,
            xPercent: 100,
        });
        return tl;
    };

    // Animation for c (banana) - spin and bounce
    const animateBanana = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-c-banana', {
            autoAlpha: 0,
            rotation: -360,
            scale: 0,
            ease: 'elastic.out(1, 0.4)',
            duration: 1,
        });
        return tl;
    };

    // Animation for k - spin
    const animateK = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-k', {
            autoAlpha: 0,
            rotation: -120,
            ease: 'elastic.out(1, 0.4)',
            duration: 2,
        });
        return tl;
    };

    const animateTwenty = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('#twenty', {
            opacity: 0,
            yPercent: 100,
        });
        return tl;
    };

    // Animation for 0 (blueberry) in 2026
    const animateBlueberry = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('.char-0-blueberry', {
            autoAlpha: 0,
            rotation: -360,
            scale: 0,
            ease: 'elastic.out(1, 0.4)',
            duration: 1,
        });
        return tl;
    };

    const animateTwentySix = () => {
        const tl = gsap.timeline({ defaults });
        tl.from('#twenty-six', {
            opacity: 0,
            textContent: 14,
            duration: 3,
            snap: { textContent: 1 }, // increment by 1
        });
        return tl;
    };

    // Main timeline
    const mainTimeline = gsap.timeline({ defaults });

    // Set initial state
    mainTimeline.set('#heading__tamuhack', { autoAlpha: 1 });

    // Add all character animations with time offsets for overlapping animations
    gsap.matchMedia().add(
        '(prefers-reduced-motion: no-preference)',
        (_context) => {
            mainTimeline.add(animateT(), 0.1);
            mainTimeline.add(animateStrawberry(), 0.3);
            mainTimeline.add(animateM(), 0.5);
            mainTimeline.add(animateU(), 0.7);
            mainTimeline.add(animateH(), 0.9);
            mainTimeline.add(animateA(), 1.1);
            mainTimeline.add(animateBanana(), 1.3);
            mainTimeline.add(animateK(), 1.5);
            mainTimeline.add(animateTwenty(), 1.5);
            mainTimeline.add(animateBlueberry(), 1.7);
            mainTimeline.add(animateTwentySix(), 1.5);
        },
    );
</script>
