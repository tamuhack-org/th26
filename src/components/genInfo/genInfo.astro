
---
import banana from '../../assets/genInfo/banana.svg';
import blueberry from '../../assets/genInfo/blueberry.svg';
import strawberry from '../../assets/genInfo/strawberry.svg';
---

<section class="hero">
  <div class="top-section">
        <div class="headline">
        <p class="intro">TAMUhack is a</p>
        <div class="title-row">
            <span class="icons">
            <img src={banana.src} class="icon" />
            <img src={strawberry.src} class="icon" />
            <img src={blueberry.src} class="icon" />
            </span>
            <h1 class="event-title">24-hour event</h1>
        </div>
        </div>

        <p class="intro">
        where teams create innovative <span class="text-blue">software &</span>
        <br />
        <span class="text-blue">hardware</span> solutions to
        </p>

        <div class="tag tag-brown">
            <p>real-world problems</p>
        </div>

        <p class="intro">
        in a community of mentorship.
        </p>
    </div>

    <div class="middle-section">
        <div class="tag tag-yellow">
            <p>$15,000+ in prizes</p>
        </div>
        <div class="tag tag-orange">
            <p>800+ attendees</p>
        </div>
    </div>
    
    <div class="bottom-section">
      <div class="location-tilt">
        <p class="info-text text-red"><span class="bold-text">Bethancourt Ballroom</span><br /> 730 Olsen Blvd <br />  College Station, TX 77485</p> 
      </div>

      <div class="hardware-tilt">
        <p class="info-text text-blue"><span class="bold-text">Interested in hardware?</span><br />Hardware will begin Jan. 15 and<br />teams will have a week to create<br />their projects.<br />More details coming soon!</p>
      </div>
    </div>
</section>

<style>
.hero{
    position: relative;
    min-height: 100vh;
    padding: 3rem 4rem;
    overflow: auto;
    max-width: 1920px;
    max-height: 100vh;
}

  .top-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: none;
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  .middle-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: none;
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  .headline {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .intro {
    font-size: 2.5rem;
    font-weight: 500;
    color: #4a4a4a;
    margin: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icons {
    display: flex;
    gap: 0.25rem;
  }

  .icon {
    width: 2.5rem;
    height: 2.5rem;
  }

  .event-title {
    font-size: 3rem;
    font-weight: 700;
    color: #e63b2e; /* Red-orange */
    margin: 0;
  }

  .text-blue {
    color: #3457C3;
    font-weight: 600;
  }

  .tag {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 1.5rem;
    font-weight: 500;
  }

  .tag-brown {
    background-color: #774A4E;
    color: #FFF6E5;
    transform: rotate(-3deg);
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
  }

  .tag-yellow {
    background-color: #EF9C26;
    color: #774A4E;
    transform: rotate(3deg);
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    margin-top: 2.0rem;
  }

  .tag-orange {
    background-color: #E3442F;
    color: #FFF6E5;
    transform: rotate(-3deg);
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
    margin-top: 1.75rem;
  }

.bottom-section {
  position: absolute; 
  right: 4rem;
  bottom: 3rem; 
  display: flex;
  flex-direction: column;
  align-items: flex-start; 
  gap: 2rem;
}

.info-text {
  font-size: 1.5rem;
  font-weight: 500;
  margin: 0;
  //text-align: left;
}

.bold-text {
  font-weight: 700;
}

.text-red {
  color: #E3442F;
}

.text-blue {
  color: #3457C3;
}

.hardware-tilt {
    transform: rotate(-1deg);
    margin-top: 2.0rem;
}

.location-tilt {
    transform: rotate(1.5deg);
}

</style>