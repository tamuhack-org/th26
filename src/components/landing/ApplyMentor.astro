---
import applyButton from '@assets/landing/apply-button.png';
import mentorButton from '@assets/landing/mentor-button.png';
import Sticker from './Sticker.astro';
---

<div class="apply-mentor-container relative z-50 flex gap-3">
    <a
        class="cursor-pointer"
        href="https://start.tamuhack.com"
        target="_blank"
        rel="noopener"
    >
        <Sticker
            imageSrc={applyButton}
            label="Apply button"
            peelDirection={-25}
            backColor="#DEC299"
            class="w-25 xl:w-30"
        />
    </a>
    <a
        class="mt-12 cursor-pointer xl:mt-15"
        href="https://tamuhack.org/mentor"
        target="_blank"
        rel="noopener"
    >
        <Sticker
            imageSrc={mentorButton}
            label="Mentor button"
            peelDirection={-25}
            backColor="#DEC299"
            class="w-25 xl:w-30"
        />
    </a>
</div>

<script>
    import { gsap } from 'gsap';

    gsap.fromTo(
        '.apply-mentor-container > a',
        { scale: 0 },
        { scale: 1, duration: 1.5, ease: 'elastic.out', delay: 0.75, stagger: 0.2 }
    );
</script>
