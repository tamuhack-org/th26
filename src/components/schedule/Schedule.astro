---
import ScheduleTransition from '@components/ScheduleTransition.astro';
import shoppingCart from '@assets/schedule/cart.png';
import lemonSchedule from '@assets/schedule/lemon-schedule.png';
import plasticWrap from '@assets/schedule/plastic.png';
import sadSeal from '@assets/schedule/sad-seal.png';
import timeTag from '@assets/schedule/time-tag.svg';
import Image from 'astro/components/Image.astro';
import ScheduleDay from './ScheduleDay.astro';
import SchedulePlant from './SchedulePlant.astro';

export interface ScheduleEvent {
    date: string;
    [key: string]: unknown;
}

const response = await fetch('https://team.tamuhack.org/api/th26');
const data: ScheduleEvent[] = await response.json();

// Filter events by day based on the date field
const saturdayEvents = data
    .filter((item: ScheduleEvent) => {
        const date = new Date(item.date);
        const dayInCST = new Date(
            date.toLocaleString('en-US', { timeZone: 'America/Chicago' }),
        ).getDay();
        return dayInCST === 6; // 6 = Saturday
    })
    .sort(
        (a: ScheduleEvent, b: ScheduleEvent) =>
            new Date(a.date).getTime() - new Date(b.date).getTime(),
    );

const sundayEvents = data
    .filter((item: ScheduleEvent) => {
        const date = new Date(item.date);
        const dayInCST = new Date(
            date.toLocaleString('en-US', { timeZone: 'America/Chicago' }),
        ).getDay();
        return dayInCST === 0; // 0 = Sunday
    })
    .sort(
        (a: ScheduleEvent, b: ScheduleEvent) =>
            new Date(a.date).getTime() - new Date(b.date).getTime(),
    );
---

<section
    class="relative left-1/2 w-screen -translate-x-1/2"
    id="schedule-container"
>
    <ScheduleTransition />
    <div class="-mt-1 bg-[#3457C3]" id="schedule">
        <div
            class="relative mx-auto flex w-full max-w-screen-2xl flex-col items-center px-8 sm:px-16"
        >
            <div
                class="mt-8 mb-12 flex w-full items-center justify-center lg:mt-1 lg:items-end lg:justify-between"
            >
                <Image
                    src={shoppingCart}
                    alt="Shopping cart"
                    class="cart-top ml-16 hidden w-[30%] lg:block"
                    id="cart-top"
                />
                <Image
                    src={lemonSchedule}
                    alt="Schedule"
                    class="w-md rotate-10 drop-shadow-xl"
                />
            </div>
            <!-- schedule row -->
            <div
                class="mb-16 flex w-full flex-col items-start justify-between gap-16 lg:flex-row lg:gap-32"
            >
                <div class="w-full lg:w-1/2">
                    <ScheduleDay day="Saturday" events={saturdayEvents} />
                </div>
                <div class="flex w-full flex-col gap-16 self-stretch lg:w-1/2">
                    <ScheduleDay day="Sunday" events={sundayEvents} />
                    <div class="relative min-h-0 w-full flex-1">
                        <Image
                            src={timeTag}
                            alt="Time tag"
                            class="pointer-events-none absolute right-0 bottom-0 z-30 h-full w-fit translate-y-1/8 rotate-4 object-contain drop-shadow-lg"
                        />
                        <Image
                            src={plasticWrap}
                            alt="Plastic wrap"
                            class="pointer-events-none absolute inset-0 z-20 h-full w-full rounded-[36px] object-fill"
                        />
                        <div
                            class="relative z-10 h-full rounded-[36px] bg-white px-4 py-3 shadow-2xl"
                        >
                            <div
                                class="h-full rounded-[36px] bg-[#C7B8B8] p-2.5"
                            >
                                <div
                                    class="h-full rounded-[36px] bg-[#D2C7C7] p-[18px]"
                                >
                                    <div
                                        class="flex h-full flex-col items-center justify-center rounded-3xl bg-white xl:pr-24"
                                    >
                                        <Image
                                            src={sadSeal}
                                            alt="Sad seal"
                                            class="w-[90%] -rotate-20 object-cover"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="hidden w-full items-center justify-center lg:flex">
                <Image
                    src={shoppingCart}
                    alt="Shopping cart"
                    class="cart-bottom mt-20 mb-24 w-[50%] max-w-160"
                    id="cart-bottom"
                />
            </div>
            <div
                class="pointer-events-none absolute -bottom-8 -left-8 z-30 hidden max-w-screen-2xl lg:block"
            >
                <!-- SVG plant decoration -->
                <!-- <SchedulePlant /> -->
            </div>
        </div>
    </div>
</section>

<style>
    @supports (animation-timeline: view()) {
        .cart-top {
            animation: cart-top-slide linear both;
            animation-timeline: view();
            animation-range: entry 210% exit 400%;
        }

        .cart-bottom {
            animation: cart-bottom-slide linear both;
            animation-timeline: view();
            animation-range: entry 0% cover 50%;
        }

        @keyframes cart-top-slide {
            from {
                transform: translateX(0);
            }
            to {
                transform: translateX(-600%);
            }
        }

        @keyframes cart-bottom-slide {
            from {
                transform: translateX(100%);
            }
            to {
                transform: translateX(0);
            }
        }
    }
</style>
