---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    imageSrc: ImageMetadata;
    label: string;
    peelDirection?: number;
    peelBackHoverPct?: number;
    backColor?: string;
    class?: string;
}

const {
    imageSrc,
    label = '',
    peelDirection = 0,
    peelBackHoverPct = 20,
    backColor = '#ffffff',
    class: className = '',
} = Astro.props;

const cssVars = {
    '--peel-direction': `${peelDirection}deg`,
    '--sticker-peelback-hover': `${peelBackHoverPct}%`,
    '--sticker-p': '10px',
    '--sticker-start': 'calc(-1 * var(--sticker-p))',
    '--sticker-end': 'calc(100% + var(--sticker-p))',
    '--back-color': backColor,
    '--sticker-img-url': `url(${imageSrc.src})`,
};
---

<div class:list={['sticker-wrapper', className]} style={cssVars}>
    <div class="sticker-container">
        <div class="sticker-main">
            <Image
                src={imageSrc}
                alt={label}
                class="sticker-image"
                draggable="false"
                quality="100"
            />
        </div>
        <div class="flap">
            <div class="flap-solid"></div>
        </div>
    </div>
</div>

<style>
    /* --- WRAPPER --- */
    .sticker-wrapper {
        display: inline-block;
        position: relative;
        transition: transform 0.2s ease-out;
        will-change: transform;
        overflow: hidden;
    }

    .sticker-wrapper:hover {
        transform: scale(1.1);
    }

    /* --- CONTAINER --- */
    .sticker-container {
        position: relative;
        width: 100%;
        transform-origin: center;
        transform: rotate(var(--peel-direction));
    }

    /* --- MAIN BODY --- */
    .sticker-main {
        clip-path: polygon(
            var(--sticker-start) var(--sticker-start),
            var(--sticker-end) var(--sticker-start),
            var(--sticker-end) var(--sticker-end),
            var(--sticker-start) var(--sticker-end)
        );
        transition: clip-path 0.3s ease-out;

        will-change: clip-path;
    }

    @media (prefers-reduced-motion: no-preference) {
        .sticker-container:hover .sticker-main {
            clip-path: polygon(
                var(--sticker-start) var(--sticker-peelback-hover),
                var(--sticker-end) var(--sticker-peelback-hover),
                var(--sticker-end) var(--sticker-end),
                var(--sticker-start) var(--sticker-end)
            );
        }
    }

    /* --- IMAGES --- */
    .sticker-image {
        width: 100%;
        height: auto;
        display: block;
        transform: rotate(calc(-1 * var(--peel-direction)));
        user-select: none;
        -webkit-user-drag: none;
    }

    /* --- FLAP --- */
    .flap {
        position: absolute;
        width: 100%;
        height: 100%;
        left: 0;
        top: calc(-100% - var(--sticker-p) - var(--sticker-p));

        clip-path: polygon(
            var(--sticker-start) var(--sticker-start),
            var(--sticker-end) var(--sticker-start),
            var(--sticker-end) var(--sticker-start),
            var(--sticker-start) var(--sticker-start)
        );
        transform: scaleY(-1);
        transition: all 0.3s ease-out;
        pointer-events: none;

        will-change: clip-path, top;
    }

    @media (prefers-reduced-motion: no-preference) {
        .sticker-container:hover .flap {
            clip-path: polygon(
                var(--sticker-start) var(--sticker-start),
                var(--sticker-end) var(--sticker-start),
                var(--sticker-end) var(--sticker-peelback-hover),
                var(--sticker-start) var(--sticker-peelback-hover)
            );
            top: calc(-100% + 2 * var(--sticker-peelback-hover) - 1px);
        }
    }

    .flap-solid {
        width: 100%;
        height: 100%;
        background-color: var(--back-color);
        -webkit-mask-image: var(--sticker-img-url);
        mask-image: var(--sticker-img-url);
        -webkit-mask-size: 100% auto;
        mask-size: 100% auto;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        transform: rotate(calc(-1 * var(--peel-direction)));
    }
</style>
