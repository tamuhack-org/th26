---
import Gsap from './Gsap.astro';
import TomatoCat from '@assets/landing/tomato-cat.svg';
import MangoBlob from '@assets/landing/mango-blob.svg';
import BlueberryBlob from '@assets/landing/blueberry-blob.svg';
import BlueberryBunny from '@assets/landing/bluebery-bunny.svg';
import RedBlob from '@assets/landing/red-blob.svg';
import MangoBird from '@assets/landing/mango-bird.svg';
import OrangeBlob from '@assets/landing/orange-blob.svg';

import ApplyMentor from './ApplyMentor.astro';
---

<section id="landing" class="mt-5 grid grid-cols-1 grid-rows-[auto_1fr] sm:grid-cols-2">
    <div
        class="flex flex-col gap-6 self-start justify-self-center sm:col-start-2 sm:col-end-3 sm:row-start-1 sm:row-end-2 sm:-ml-[15%]"
    >
        <Gsap />
        <div class="ml-[33%] xl:ml-[50%]">
            <ApplyMentor />
        </div>
    </div>
    <div
        class="relative z-0 -mt-24 aspect-square w-full overflow-hidden sm:col-start-1 sm:col-end-2 sm:row-start-1 sm:row-end-3 sm:mt-0 sm:overflow-visible"
    >
        <TomatoCat class="absolute -left-10 h-auto w-5/12" />
        <MangoBlob
            class="absolute top-[18%] left-[45%] hidden h-auto w-1/4 sm:block"
        />
        <BlueberryBlob
            class="absolute bottom-[52%] left-[5%] hidden h-auto w-1/10 sm:block"
        />
        <BlueberryBunny
            class="absolute bottom-[35%] -left-1 z-50 h-auto w-2/7 sm:bottom-[45%] sm:left-[25%]"
        />
        <OrangeBlob
            class="absolute bottom-[32%] left-1/2 hidden h-auto w-1/10 sm:block"
        />
        <RedBlob
            class="absolute bottom-[30%] left-[15%] hidden h-auto w-1/4 sm:block"
        />
        <MangoBird
            class="absolute bottom-[20%] left-[30%] h-auto w-4/9 sm:-right-10 sm:bottom-[12%] sm:left-auto"
        />
    </div>
</section>
