---
import { Image } from 'astro:assets';

import banana from '@assets/landing/banana.svg';
import blueberry from '@assets/landing/blueberry.svg';
import strawberry from '@assets/landing/strawberry.svg';

import strawberrysimple from '@assets/genInfo/strawberry.svg';
import blueberrysimple from '@assets/genInfo/blueberry.svg';

import bananaSticker from '@assets/genInfo/sticker-banana.png';
import starSticker from '@assets/genInfo/sticker-star.png';
import heart from '@assets/genInfo/sticker-heart.png';

import QuestionSeals from './QuestionSeals.astro';
import LaptopTigers from './LaptopTigers.astro';
---

<section id="general-info" class="hero mx-auto max-w-300">
    <div class="top-section">
        <span>TAMUhack is a</span>
        <div class="title-row">
            <img
                src={banana.src}
                class="icon"
                alt="Banana"
                aria-hidden="true"
                loading="lazy"
            />
            <img
                src={strawberry.src}
                class="icon"
                alt="Strawberry"
                aria-hidden="true"
                loading="lazy"
            />
            <img
                src={blueberry.src}
                class="icon"
                alt="Blueberry"
                aria-hidden="true"
                loading="lazy"
            />
            <span class="event-title">24-hour event</span>
        </div>

        <span>
            where teams create innovative <span class="text-blue"
                >software &</span
            >
            <br aria-hidden="true" />
            <span class="text-blue">hardware</span> solutions to
        </span>

        <span class="tag tag-brown"> real-world problems </span>

        <span>
            in a community <Image
                src={heart}
                class="icon-heart heart-mobile"
                alt="Heart sticker"
                aria-hidden="true"
            /> of mentorship. <Image
                src={heart}
                class="icon-heart heart-desktop"
                alt="Heart sticker"
                aria-hidden="true"
            />
        </span>
    </div>

    <div class="middle-section">
        <div class="middle-section-tags">
            <div class="tag-wrapper-orange">
                <div class="tag tag-orange">
                    <p>800+ attendees</p>
                </div>
                <svg
                    width="34"
                    height="25"
                    viewBox="0 0 34 25"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="sticker squiggle"
                    id="squiggle"
                    aria-hidden="true"
                >
                    <path
                        d="M1.34033 9.15907C4.14758 0.135754 17.3818 -1.46839 20.5901 6.75285C23.7984 14.9741 16.828 20.4078 13.1709 16.9792C9.96261 13.9714 19.5875 6.75269 27.0066 8.75795C34.4258 10.7632 35.2279 22.5937 24.6004 23.3958"
                        stroke="#EF9C26"
                        stroke-width="2.80725"></path>
                </svg>
                <img
                    src={starSticker.src}
                    class="sticker sticker-star"
                    alt="Star sticker"
                    aria-hidden="true"
                    loading="lazy"
                />
            </div>

            <div class="tag-wrapper-yellow">
                <div class="tag tag-yellow">
                    <p>$15,000+ in prizes</p>
                </div>
                <img
                    src={bananaSticker.src}
                    class="sticker sticker-banana"
                    alt="Banana sticker"
                    aria-hidden="true"
                    loading="lazy"
                />
            </div>
        </div>
        <div class="middle-section-assets">
            <LaptopTigers />
        </div>
    </div>

    <div class="bottom-section mt-16">
        <QuestionSeals />
        <div>
            <div class="location-tilt">
                <img
                    src={strawberrysimple.src}
                    class="icon-simple"
                    alt="Strawberry simple"
                    aria-hidden="true"
                    loading="lazy"
                />
                <p class="info-text text-red">
                    <a
                        href="https://maps.app.goo.gl/bYpQSp2hCgDD7wWQ7"
                        target="_blank"
                        ><span class="semibold-text">Bethancourt Ballroom</span
                        ><br /> 275 Joe Routt Blvd <br /> College Station, TX 77485</a
                    >
                </p>
            </div>

            <div class="hardware-tilt mt-4">
                <img
                    src={blueberrysimple.src}
                    class="icon-simple"
                    alt="Blueberry simple"
                    aria-hidden="true"
                    loading="lazy"
                />
                <div>
                    <p class="info-text text-blue">
                        <span class="bold-text">Interested in hardware?</span
                        ><br />Hardware will begin Jan. 16 and<br
                            aria-hidden="true"
                        />teams will have a week to create<br
                            aria-hidden="true"
                        />their projects.
                    </p>
                    <p class="text-blue text-base sm:text-xl">
                        More details coming soon!
                    </p>
                </div>
            </div>
        </div>
    </div>
    <p class="text-brown mx-auto mt-16 max-w-[80ch] text-sm">
        <strong>Note: </strong>Acceptances will be sent out on a rolling basis.
        If you are accepted, you must check in before 11 AM or your acceptance
        will be forfeited. We will have a waitlist line for students who are not
        accepted. After 11 AM, we will admit people from the waitlist line until
        the MSC capacity has been reached.
    </p>
</section>

<style>
    .hero {
        position: relative;
        min-height: 100vh;
        padding-left: 2rem;
        padding-right: 2rem;
        padding-bottom: 2rem;
        font-size: 1.5rem;
    }

    .top-section {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        max-width: none;
        width: 100%;
        height: 100%;
        position: relative;
        z-index: 2;
        color: #774a4e;
    }

    .middle-section {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 0.75rem;
        max-width: none;
        width: 100%;
        position: relative;
        z-index: 2;
        margin-top: 5%;
        justify-content: center;
    }

    .middle-section-tags {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        max-width: none;
        width: 100%;
        height: 100%;
        position: relative;
        z-index: 2;
    }

    .middle-section-assets {
        display: none;
        flex-direction: column;
        align-items: flex-start;
        max-width: 500px;
        width: 100%;
        height: 100%;
        margin-top: 30%;
        position: relative;
        z-index: 2;
    }

    .headline {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .intro {
        font-size: 2.5rem;
        font-weight: 500;
        color: #4a4a4a;
        margin: 0;
    }

    .title-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .icons {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .icon {
        height: 1em;
        width: auto;
        display: inline-block;
    }

    .icon-heart {
        height: 2em;
        display: inline-block;
        width: auto;
    }

    .event-title {
        font-weight: 500;
        color: #e63b2e; /* Red-orange */
        margin: 0;
        font-size: 1.875rem;
    }

    .text-blue {
        color: #3457c3;
    }

    .tag {
        display: inline-block;
        padding: 0.5rem 1.25rem;
        border-radius: 0.5rem;
        font-weight: 500;
    }

    .tag-brown {
        background-color: #774a4e;
        color: #fff6e5;
        transform: rotate(-3deg);
        box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
        margin-block: 1rem;
    }

    .tag-yellow {
        background-color: #ef9c26;
        color: #774a4e;
        transform: rotate(3deg);
        box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
        margin-top: 2rem;
        white-space: nowrap;
    }

    .tag-orange {
        background-color: #e3442f;
        color: #fff6e5;
        transform: rotate(-3deg);
        box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5);
        margin-top: 1.75rem;
        white-space: nowrap;
        align-self: flex-start;
    }

    .tag-wrapper {
        position: relative;
        width: fit-content;
    }

    .tag-wrapper-orange {
        align-self: flex-start;
        position: relative;
        width: fit-content;
    }

    .tag-wrapper-yellow {
        align-self: flex-end;
        position: relative;
        width: fit-content;
    }

    .sticker {
        position: absolute;
    }

    .sticker-banana {
        width: 23%;
        top: 0%;
        right: -10%;
    }

    .squiggle {
        transform: scale(2.3);
        top: 15%;
        right: 0%;
    }

    .sticker-star {
        width: 20%;
        top: 45%;
        left: -8%;
        transform: translateY(-50%);
    }

    .bottom-section {
        display: flex;
        flex-direction: row;
        justify-content: center;
        gap: 4rem;
        position: relative;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
    }

    .info-text {
        font-size: 1.25rem;
        margin-top: 1rem;
    }

    .bold-text {
        font-weight: 700;
    }

    .semibold-text {
        font-weight: 600;
    }

    .text-red {
        color: #e3442f;
    }

    .text-blue {
        color: #3457c3;
    }

    .hardware-tilt {
        /* transform: rotate(-1deg); */
    }

    .location-tilt {
        /* transform: rotate(1.5deg); */
    }

    .icon-simple {
        height: 2em;
        width: auto;
    }

    .heart-desktop {
        display: none;
    }

    .heart-mobile {
        display: inline;
    }

    @media (min-width: 630px) {
        .middle-section-assets {
            display: flex;
            flex-direction: column;
            align-items: center;
            max-width: 700px;
            width: 100%;
            height: 100%;
            margin-top: -15%;
            margin-left: 5%;
            position: relative;
            transform: translateY(5%);
            z-index: 2;
        }

        .tag-wrapper-orange {
            position: relative;
            width: fit-content;
            align-self: unset;
        }

        .tag-wrapper-yellow {
            position: relative;
            width: fit-content;
            align-self: unset;
        }

        .middle-section {
            display: flex;
            flex-direction: row;
            align-items: flex-end;
            gap: 0.75rem;
            max-width: none;
            width: 100%;
            position: relative;
            z-index: 2;
        }

        .middle-section-tags {
            display: flex;
            flex-direction: column-reverse;
            align-items: center;
            justify-content: flex-end;
            gap: 2rem;
            position: relative;
            z-index: 2;
        }

        .heart-desktop {
            display: inline;
        }

        .heart-mobile {
            display: none;
        }

        .tag {
            display: inline-block;
            padding: 0.5rem 1.25rem;
            border-radius: 0.5rem;
            font-weight: 500;
            font-size: 3rem;
        }

        .hero {
            font-size: 3rem;
        }

        .event-title {
            font-size: 3.5rem;
        }

        .sticker-banana {
            width: 17%;
            top: 0%;
            right: -8%;
        }

        .sticker-star {
            width: 15%;
            top: 40%;
            left: -5%;
            transform: translateY(-50%);
        }
    }

    @media (min-width: 630px) {
        .info-text {
            font-size: 2rem;
        }

        .bottom-section {
            display: flex;
            flex-direction: row;
            justify-content: space-around;
            gap: 2rem;
            position: relative;
        }

        .location-tilt {
            align-items: center;
            display: flex;
            flex-direction: row;
            gap: 1rem;
            transform: rotate(1.2deg);
        }

        .hardware-tilt {
            align-items: center;
            display: flex;
            flex-direction: row-reverse;
            gap: 1rem;
            transform: rotate(-0.9deg);
        }
    }

    @media (max-width: 630px) {
        .middle-section-assets {
            display: none;
        }

        .middle-section {
            margin-top: 5%;
            justify-content: center;
        }

        .middle-section-tags {
            flex-direction: column-reverse;
            align-items: center;
        }

        .bottom-section > div {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 2rem;
            position: relative;
        }
    }

    @media (min-width: 1400px) {
        .bottom-section {
            gap: 8rem;
        }
    }
</style>

<script>
    import gsap from 'gsap';
    import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(DrawSVGPlugin, ScrollTrigger);
    console.clear();

    const defaults = {
        ease: 'power2.out',
        duration: 1,
    };

    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        gsap.set('#squiggle path', { drawSVG: '0%' });
        gsap.to('#squiggle path', {
            drawSVG: '100%',
            duration: 1,
            ease: 'power2.out',
            scrollTrigger: {
                trigger: '#squiggle',
                start: 'top 65%',
            },
        });
        const tl24 = gsap.timeline({
            scrollTrigger: {
                trigger: '.title-row',
                start: 'top 75%',
                once: true,
            },
        });

        tl24.from('.icon', {
            y: 50,
            opacity: 0,
            scale: 0.5,
            filter: 'grayscale(100%)', // maybe change, start b/w
            rotation: 15,
            duration: 0.8,
            stagger: 0.1,
            ease: 'back.out(1.7)',
        }).from(
            '.event-title',
            {
                x: 15,
                opacity: 0,
                filter: 'blur(4px)',
                duration: 0.6,
                ease: 'power2.out',
            },
            '-=0.6',
        );
        gsap.from('.tag-brown', {
            scrollTrigger: {
                trigger: '.tag-brown',
                start: 'top 65%',
            },
            rotate: 10,
            y: -15,
            opacity: 0,
            transformOrigin: '50% 0%', // TY chat for hinge point
            duration: 1.3,
            ease: 'elastic.out(0.7, 0.5)',
        });
        const signTags = ['.tag-yellow', '.tag-orange'];

        gsap.from(signTags, {
            scrollTrigger: {
                trigger: '.middle-section-tags',
                start: 'top 65%',
            },
            y: -40,
            opacity: 0,
            rotation: (i) => (i % 2 === 0 ? 10 : -10),
            transformOrigin: '50% 0%',
            duration: 0.6,
            stagger: 0.5,
            ease: 'back.out(1.4)',
        });

        // erm we need to select the hw/sw text only, probs should've added an id
        const fluidText = document.querySelectorAll('.top-section .text-blue');

        gsap.from(fluidText, {
            scrollTrigger: {
                trigger: fluidText,
                start: 'top 80%', // Triggers slightly earlier so it meets the user's eye
                once: true,
            },
            y: 30,
            opacity: 0,
            filter: 'blur(8px)',
            duration: 0.8,
            stagger: 0.2,
            ease: 'power3.out',
        });
    });

    const icons = ['.icon-heart', '.sticker-banana', '.sticker-star'];
    gsap.fromTo(
        icons,
        { scale: 1.3, opacity: 0 },

        {
            scale: 1,
            duration: 0.3,
            ease: 'power2.out',
            opacity: 1,
            rotate: () => gsap.utils.random(-30, 30),

            stagger: 0.2,
            scrollTrigger: {
                trigger: '.middle-section-tags',
                start: 'top 75%',
            },
        },
    );
</script>
