---
import SectionItem from './SectionItem.astro';
import sections from './questions.json';
---

<div
    class="border-brown font-family-franklin rounded-sm border-4 bg-white p-4 font-semibold"
>
    <h2 aria-hidden="true" class="mb-2 text-4xl font-black sm:text-5xl">
        Frequently Asked
    </h2>
    <p class="border-brown mb-2 border-t-4 border-b-32 py-1">
        1 - 4 Participants Per Team
    </p>
    <h2 class="text-3xl font-black sm:text-4xl" aria-hidden="true">
        Questions
    </h2>
    <h3
        aria-hidden="true"
        class="border-brown mt-2 border-t-16 py-1 text-right text-xl font-black"
    >
        % Daily Value*
    </h3>
    {
        sections.map((section) => (
            <SectionItem title={section.title} questions={section.questions} />
        ))
    }
    <div class="bg-brown h-4 w-full"></div>
    <p class="pt-4 pb-2 text-lg">
        *Can't find what you're looking for? <a
            href="mailto:hello@tamuhack.com"
            class="underline">Contact Our Team</a
        >
    </p>
</div>
