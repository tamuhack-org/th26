---
import { Image } from 'astro:assets';

export const enum Tier {
	SMALL = 'small',
	MEDIUM = 'medium',
	LARGE = 'large',
	PARTNER = 'partner',
}

interface Props {
	imagePath: string;
	name: string;
	href: string;
	tier: Tier;
}

const { imagePath, name, href, tier } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/sponsors/*.{jpeg,jpg,png,gif,svg}',
);

const sponsorsImagePath = '/src/assets/sponsors/';

const fullImagePath = sponsorsImagePath + imagePath;

if (!images[fullImagePath])
	throw new Error(
		`"${fullImagePath}" does not exist in glob: "src/assets/sponsors/*.{jpeg,jpg,png,gif,svg}"`,
	);

let width = '';
let basis = '';
if (tier === Tier.SMALL) {
	basis = 'basis-1/2 md:basis-1/4';
	width = 'w-1/2';
} else if (tier === Tier.PARTNER) {
	basis = 'basis-full md:basis-1/3';
	width = 'w-1/3 md:w-3/5';
} else {
	basis = 'basis-full md:basis-1/2';
	if (tier === Tier.MEDIUM) {
		width = 'w-3/5';
	} else {
		// if tier is large
		width = 'w-3/4';
	}
}
// width overrides
if (name === 'USAA' || name === 'AWS') width = 'w-1/3';
if (name === 'Phillips 66') width = 'w-1/4';
if (name === 'IEEE TAMU') width = 'w-3/5 md:w-full';
---

<a
	href={href}
	target="_blank"
	rel="noreferrer noopener"
	class:list={[
		'flex items-center justify-center grayscale transition-all duration-300 hover:grayscale-0',
		basis,
	]}
>
	<Image
		src={images[fullImagePath]()}
		alt={`${name} homepage`}
		class={width}
	/>
</a>
