---
import LinkSection from './LinkSection.astro';
import {
    resources,
    socials,
    otherHackathons,
    workshops,
} from './footer-links.js';
---

<div class="text-brown mx-auto max-w-screen-2xl px-8 py-4 lg:px-16">
    <footer class="items-center lg:flex lg:justify-between lg:gap-16">
        <div class="text-center opacity-90 lg:text-start">
            <p
                class="tag-news color-brown mb-4 inline-block -rotate-[0.5deg] rounded-lg bg-[#ef9c26] px-5 py-2 text-lg font-semibold whitespace-nowrap shadow-[5px_5px_10px_rgba(0,0,0,0.5)] sm:text-3xl"
            >
                Sign up to our newsletter
            </p>
            <p>
                Stay connected! Sign up for our mailing list for events,
                updates, and more.
            </p>
        </div>
        <form
            action="https://tamuhack.us21.list-manage.com/subscribe?u=6916895bdf09ac34cd4e523b9&id=669dbb893c"
            method="post"
            id="mc-embedded-subscribe-form"
            name="mc-embedded-subscribe-form"
            target="_blank"
            novalidate
            class="flex flex-col items-center justify-start gap-2 lg:flex-row lg:items-stretch"
        >
            <div
                class="flex w-full flex-row items-stretch justify-center gap-3 px-4 py-4 max-[27.5rem]:flex-col max-[27.5rem]:justify-stretch lg:flex-none lg:gap-5 lg:px-0"
            >
                <label for="mce-EMAIL" class="hidden">Email Address</label>
                <input
                    type="text"
                    name="EMAIL"
                    placeholder="Enter your email address"
                    class="border-brown w-64 rounded-lg border px-4 py-2 max-[27.5rem]:w-full 2xl:w-96"
                    id="mce-EMAIL"
                />
                <button class="clear">
                    <input
                        type="submit"
                        value="Subscribe"
                        name="subscribe"
                        id="mc-embedded-subscribe"
                        class="border-brown hover:bg-brown h-full cursor-pointer rounded-lg border px-4 py-2 text-base font-bold transition-colors duration-200 hover:text-white"
                    />
                </button>
            </div>
            <!-- Mailchip bot prevention -->
            <div aria-hidden="true" class="absolute -left-[5000px]">
                <input
                    type="text"
                    name="b_43a795784ca963e25903a0da6_9937fe4fc5"
                    tabindex="-1"
                    value=""
                />
            </div>
        </form>
    </footer>

    <footer
        id="resources"
        class="text-dark my-8 justify-between opacity-90 lg:my-16 xl:flex"
    >
        <div class="xl:w-1/3">
            <p class="font-family-bbh mb-8 text-3xl tracking-wider lg:text-4xl">
                TAMUHACK 2026
            </p>
            <p class="font-base mb-8 text-xl">
                Website brought to you by the TAMUhack Design + Development
                Teams
            </p>
        </div>
        <div
            class="flex grow flex-wrap justify-start gap-12 lg:ml-12 lg:justify-end"
        >
            <LinkSection title="Hacker Resources" items={resources} />
            <LinkSection title="Socials" items={socials} />
            <LinkSection title="Other Hackathons" items={otherHackathons} />
            <LinkSection title="Workshops" items={workshops} />
        </div>
    </footer>

    <footer class="bottom-0">
        <div class="bg-dark bg-opacity-5 mx-8 h-[3px] rounded-xl"></div>
        <p class="text-dark py-3 text-sm font-light">
            Interested in sponsoring? Reach out to us at{' '}
            <a class="underline" href="mailto:sponsor@tamuhack.com">
                sponsor@tamuhack.com
            </a>.
        </p>
    </footer>
</div>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(DrawSVGPlugin, ScrollTrigger);
    console.clear();

    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        gsap.from('.tag-news', {
            scrollTrigger: {
                trigger: '.tag-news',
                start: 'top 65%',
            },
            rotate: 10,
            y: -40,
            opacity: 0,
            transformOrigin: '50% 0%',
            duration: 0.5,
            ease: 'power2.out',
        });
    });
</script>
