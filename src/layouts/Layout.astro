---
import '../styles/global.css';
import { Font } from 'astro:assets';

import Header from '@components/Header.astro';
import MenuButton from '@components/MenuButton.astro';
import Footer from '@components/footer/Footer.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta name="generator" content={Astro.generator} />
        <title>TAMUhack 2026</title>
        <Font
            cssVariable="--font-stack-sans"
            preload={[
                { weight: '400' },
                { weight: '500' },
                { weight: '600' },
                { weight: '700' },
            ]}
        />
        <Font cssVariable="--font-bbh-sans" preload />
        <Font cssVariable="--font-libre-franklin" />
    </head>
    <body>
        <div class="relative mx-auto max-w-500">
            <Header />
            <MenuButton />
            <main>
                <slot />
            </main>
        </div>
        <Footer />
    </body><style>
        html {
            margin: 0;
            scroll-behavior: smooth;
            height: 100%;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            font-family: var(--font-stack-sans), sans-serif;
            --background: #fff6e5;

            background-color: var(--background);
            overflow-x: hidden;
        }
    </style>
</html>
