---
import Gsap from './Gsap.astro';
import TomatoCat from '@assets/landing/tomato-cat.svg';
import MangoBlob from '@assets/landing/mango-blob.svg';
import BlueberryBlob from '@assets/landing/blueberry-blob.svg';
import BlueberryBunny from '@assets/landing/blueberry-bunny.svg';
import RedBlob from '@assets/landing/red-blob.svg';
import MangoBird from '@assets/landing/mango-bird.svg';
import OrangeBlob from '@assets/landing/orange-blob.svg';

import ApplyMentor from './ApplyMentor.astro';
---

<section
    id="landing"
    class="mt-5 grid grid-cols-1 grid-rows-[auto_1fr] sm:grid-cols-2"
>
    <div
        class="flex flex-col gap-6 self-start justify-self-center sm:col-start-2 sm:col-end-3 sm:row-start-1 sm:row-end-2 sm:-ml-[15%]"
    >
        <Gsap />
        <div class="ml-[33%] xl:ml-[50%]">
            <ApplyMentor />
        </div>
    </div>
    <div
        class="relative z-0 -mt-24 aspect-square w-full overflow-hidden sm:col-start-1 sm:col-end-2 sm:row-start-1 sm:row-end-3 sm:mt-0 sm:overflow-visible"
        aria-hidden="true"
    >
        <TomatoCat class="landing-item absolute -left-10 h-auto w-7/16" />
        <MangoBlob
            class="landing-item absolute top-[18%] left-[45%] hidden h-auto w-1/4 sm:block"
        />
        <BlueberryBlob
            class="landing-item absolute bottom-[52%] left-[5%] hidden h-auto w-1/10 sm:block"
        />
        <BlueberryBunny
            class="landing-item absolute bottom-[35%] -left-1 z-50 h-auto w-3/10 sm:bottom-[45%] sm:left-[25%]"
        />
        <OrangeBlob
            class="landing-item absolute bottom-[32%] left-1/2 hidden h-auto w-1/10 sm:block"
        />
        <RedBlob
            class="landing-item absolute bottom-[30%] left-[15%] hidden h-auto w-1/4 sm:block"
        />
        <MangoBird
            class="landing-item absolute bottom-[20%] left-[30%] h-auto w-4/9 sm:-right-10 sm:bottom-[12%] sm:left-auto"
        />
    </div>
</section>

<script>
    import { gsap } from 'gsap';
    gsap.utils.toArray('.landing-item').forEach((item) => {
        item.addEventListener('mousemove', (e) => {
            const rect = item.getBoundingClientRect();

            // cursor position relative to center of item
            const relX = e.clientX - (rect.left + rect.width / 2);
            const relY = e.clientY - (rect.top + rect.height / 2);

            // move item a fraction toward cursor
            gsap.to(item, {
                x: relX * 0.15, // 0.15 = how strong the effect is
                y: relY * 0.15,
                duration: 0.4,
                ease: 'power2.out',
            });
        });

        item.addEventListener('mouseleave', () => {
            // reset same as reverse()
            gsap.to(item, {
                x: 0,
                y: 0,
                duration: 0.6,
                ease: 'power3.out',
            });
        });
    });
</script>
