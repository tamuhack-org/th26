---
import { Icon } from 'astro-icon/components';

interface Props {
	question: { question: string; answers: string[] };
}

const { question } = Astro.props;

const parseLinks = (text: string) => {
	return text.replace(
		/\[(.*?)\]\((.*?)\)/g,
		'<a href="$2" target="_blank" rel="noopener noreferrer" class="font-semibold text-inherit underline">$1</a>',
	);
};
---

<details
	class="accordion-item border-brown group overflow-hidden border-t py-3"
>
	<summary
		class="flex cursor-pointer list-none justify-between text-lg font-bold transition-colors"
	>
		<h2>{question.question}</h2>
		<div class="chevron-icon">
			<Icon name="tabler:chevron-down" class="text-3xl" />
		</div>
	</summary>

	<div class="accordion-content">
		<div class="flex flex-col gap-4 pt-3 pr-30">
			{
				question.answers.map((answer) => (
					<p set:html={parseLinks(answer)} />
				))
			}
		</div>
	</div>
</details>

<style>
	summary::-webkit-details-marker {
		display: none;
	}
</style>

<script>
	import { gsap } from 'gsap';

	// use select all since this script will just be written in the dom once by astro
	// -- kept in this file for reference
	const details = document.querySelectorAll('details.accordion-item');

	details.forEach((targetDetail) => {
		const summary = targetDetail.querySelector('summary');
		const content = targetDetail.querySelector('.accordion-content');
		const icon = targetDetail.querySelector('.chevron-icon');

		if (!summary || !content || !icon) return;

		let isAnimating = false;

		summary.addEventListener('click', (e) => {
			e.preventDefault();

			if (isAnimating) return;

			isAnimating = true;

			const isOpen = targetDetail.hasAttribute('open');

			if (isOpen) {
				gsap.to(content, {
					height: 0,
					duration: 0.25,
					ease: 'power2.out',
					onComplete: () => {
						targetDetail.removeAttribute('open');
						isAnimating = false;
					},
				});

				gsap.to(icon, { rotateX: 0, duration: 0.25 });
			} else {
				targetDetail.setAttribute('open', 'true');

				gsap.fromTo(
					content,
					{ height: 0 },
					{
						height: 'auto',
						duration: 0.25,
						ease: 'power2.out',
						onComplete: () => {
							isAnimating = false;
						},
					},
				);

				gsap.to(icon, { rotateX: 180, duration: 0.25 });
			}
		});
	});
</script>
